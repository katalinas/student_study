[
  {"id":"moral_wisdom_001","text":"书山有路勤为径，学海无涯苦作舟。","source":"韩愈","category":"勤奋","grade_min":3,"grade_max":9},
  {"id":"moral_wisdom_002","text":"业精于勤，荒于嬉；行成于思，毁于随。","source":"韩愈《进学解》","category":"勤奋","grade_min":4,"grade_max":9},
  {"id":"moral_wisdom_003","text":"天才是百分之一的灵感加上百分之九十九的汗水。","source":"爱迪生","category":"勤奋","grade_min":2,"grade_max":9},
  {"id":"moral_wisdom_004","text":"聪明在于学习，天才在于积累。","source":"华罗庚","category":"勤奋","grade_min":3,"grade_max":9},
  {"id":"moral_wisdom_005","text":"宝剑锋从磨砺出，梅花香自苦寒来。","source":"古训","category":"勤奋","grade_min":3,"grade_max":9},
  {"id":"moral_wisdom_006","text":"少壮不努力，老大徒伤悲。","source":"《长歌行》","category":"勤奋","grade_min":2,"grade_max":9},
  {"id":"moral_wisdom_007","text":"勤能补拙是良训，一分辛苦一分才。","source":"华罗庚","category":"勤奋","grade_min":3,"grade_max":9},
  {"id":"moral_wisdom_008","text":"不积跬步，无以至千里；不积小流，无以成江海。","source":"荀子《劝学》","category":"勤奋","grade_min":4,"grade_max":9},
  {"id":"moral_wisdom_009","text":"勇气不是没有恐惧，而是判断有比恐惧更重要的事情。","source":"安布罗斯·雷德穆恩","category":"勇气","grade_min":4,"grade_max":9},
  {"id":"moral_wisdom_010","text":"千里之行，始于足下。","source":"老子《道德经》","category":"勇气","grade_min":2,"grade_max":9},
  {"id":"moral_wisdom_011","text":"世上无难事，只要肯登攀。","source":"毛泽东","category":"勇气","grade_min":2,"grade_max":9},
  {"id":"moral_wisdom_012","text":"生当作人杰，死亦为鬼雄。","source":"李清照《夏日绝句》","category":"勇气","grade_min":4,"grade_max":9},
  {"id":"moral_wisdom_013","text":"勇敢的人不是不害怕的人，而是即使害怕也能克服恐惧继续前行的人。","source":"纳尔逊·曼德拉","category":"勇气","grade_min":4,"grade_max":9},
  {"id":"moral_wisdom_014","text":"有志者事竟成。","source":"《后汉书》","category":"勇气","grade_min":2,"grade_max":9},
  {"id":"moral_wisdom_015","text":"路漫漫其修远兮，吾将上下而求索。","source":"屈原《离骚》","category":"勇气","grade_min":5,"grade_max":9},
  {"id":"moral_wisdom_016","text":"明知山有虎，偏向虎山行。","source":"民间谚语","category":"勇气","grade_min":3,"grade_max":9},
  {"id":"moral_wisdom_017","text":"勿以恶小而为之，勿以善小而不为。","source":"刘备《诫子书》","category":"善良","grade_min":3,"grade_max":9},
  {"id":"moral_wisdom_018","text":"赠人玫瑰，手有余香。","source":"谚语","category":"善良","grade_min":2,"grade_max":9},
  {"id":"moral_wisdom_019","text":"己所不欲，勿施于人。","source":"孔子《论语》","category":"善良","grade_min":3,"grade_max":9},
  {"id":"moral_wisdom_020","text":"老吾老以及人之老，幼吾幼以及人之幼。","source":"孟子","category":"善良","grade_min":4,"grade_max":9},
  {"id":"moral_wisdom_021","text":"善良是一种语言，聋人能听到，盲人能看到。","source":"马克·吐温","category":"善良","grade_min":3,"grade_max":9},
  {"id":"moral_wisdom_022","text":"一个人可以没有钱，但不能没有善心。","source":"格言","category":"善良","grade_min":2,"grade_max":9},
  {"id":"moral_wisdom_023","text":"爱人者，人恒爱之；敬人者，人恒敬之。","source":"孟子","category":"善良","grade_min":4,"grade_max":9},
  {"id":"moral_wisdom_024","text":"帮助别人就是帮助自己。","source":"格言","category":"善良","grade_min":2,"grade_max":9},
  {"id":"moral_wisdom_025","text":"知之为知之，不知为不知，是知也。","source":"孔子《论语》","category":"智慧","grade_min":3,"grade_max":9},
  {"id":"moral_wisdom_026","text":"学而不思则罔，思而不学则殆。","source":"孔子《论语》","category":"智慧","grade_min":3,"grade_max":9},
  {"id":"moral_wisdom_027","text":"三人行，必有我师焉。择其善者而从之，其不善者而改之。","source":"孔子《论语》","category":"智慧","grade_min":3,"grade_max":9},
  {"id":"moral_wisdom_028","text":"读万卷书，行万里路。","source":"刘彝","category":"智慧","grade_min":3,"grade_max":9},
  {"id":"moral_wisdom_029","text":"知识就是力量。","source":"弗朗西斯·培根","category":"智慧","grade_min":2,"grade_max":9},
  {"id":"moral_wisdom_030","text":"吾生也有涯，而知也无涯。","source":"庄子","category":"智慧","grade_min":5,"grade_max":9},
  {"id":"moral_wisdom_031","text":"纸上得来终觉浅，绝知此事要躬行。","source":"陆游《冬夜读书示子聿》","category":"智慧","grade_min":4,"grade_max":9},
  {"id":"moral_wisdom_032","text":"尽信书不如无书。","source":"孟子","category":"智慧","grade_min":5,"grade_max":9},
  {"id":"moral_wisdom_033","text":"锲而不舍，金石可镂。","source":"荀子《劝学》","category":"坚持","grade_min":4,"grade_max":9},
  {"id":"moral_wisdom_034","text":"只要功夫深，铁杵磨成针。","source":"民间故事（李白）","category":"坚持","grade_min":2,"grade_max":9},
  {"id":"moral_wisdom_035","text":"失败是成功之母。","source":"谚语","category":"坚持","grade_min":2,"grade_max":9},
  {"id":"moral_wisdom_036","text":"绳锯木断，水滴石穿。","source":"罗大经《鹤林玉露》","category":"坚持","grade_min":3,"grade_max":9},
  {"id":"moral_wisdom_037","text":"成功不是终点，失败也不是终结，唯有继续前行的勇气才最重要。","source":"丘吉尔","category":"坚持","grade_min":4,"grade_max":9},
  {"id":"moral_wisdom_038","text":"不经一番寒彻骨，怎得梅花扑鼻香。","source":"黄蘖禅师","category":"坚持","grade_min":3,"grade_max":9},
  {"id":"moral_wisdom_039","text":"精诚所至，金石为开。","source":"《庄子》","category":"坚持","grade_min":4,"grade_max":9},
  {"id":"moral_wisdom_040","text":"咬定青山不放松，立根原在破岩中。","source":"郑燮《竹石》","category":"坚持","grade_min":3,"grade_max":9}
]
