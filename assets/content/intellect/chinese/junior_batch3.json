[
  {"id":"intellect_q_5280","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":3,"tags":["chinese","文言文断句"],"subject":"chinese","stem":"\"学而时习之不亦说乎\"正确的断句是？","stem_image":null,"options":[{"label":"A","text":"学而/时习之/不亦/说乎"},{"label":"B","text":"学/而时习之/不亦说乎"},{"label":"C","text":"学而时习之/不亦说乎"},{"label":"D","text":"学而时/习之不/亦说乎"}],"answer":"C","explanation":"正确断句：学而时习之/不亦说乎。前半句是陈述学习实践，后半句是反问。","hint":"找\"不亦...乎\"这个句式。","time_limit_seconds":30,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5281","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":4,"tags":["chinese","文言文断句"],"subject":"chinese","stem":"\"温故而知新可以为师矣\"正确的断句是？","stem_image":null,"options":[{"label":"A","text":"温故而知新/可以为师矣"},{"label":"B","text":"温故/而知新可以/为师矣"},{"label":"C","text":"温故而/知新可以/为师矣"},{"label":"D","text":"温故而知/新可以为/师矣"}],"answer":"A","explanation":"\"温故而知新\"是一个完整的条件分句，\"可以为师矣\"是结论。","hint":"\"矣\"是语气词，常在句末。","time_limit_seconds":30,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5282","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":4,"tags":["chinese","文言文断句"],"subject":"chinese","stem":"\"其一犬坐于前\"（《狼》）正确的断句和解释是？","stem_image":null,"options":[{"label":"A","text":"其一/犬坐于前（其中一只像狗一样蹲坐在前面）"},{"label":"B","text":"其/一犬/坐于前（那一只狗坐在前面）"},{"label":"C","text":"其一犬/坐于前（那一只狗坐在前面）"},{"label":"D","text":"其/一/犬坐于前（其中一个像狗一样坐在前面）"}],"answer":"A","explanation":"\"其一\"指其中一只狼，\"犬坐于前\"指像狗一样蹲坐在前面。\"犬\"是名词作状语。","hint":"\"犬\"在这里是什么用法？","time_limit_seconds":30,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5283","module":"intellect","type":"question","subtype":"fill_blank","grade_min":7,"grade_max":9,"difficulty":3,"tags":["chinese","文言文断句"],"subject":"chinese","stem":"\"三人行必有我师焉\"断句为：____/____。","stem_image":null,"options":null,"answer":"三人行/必有我师焉","explanation":"\"三人行\"是条件，\"必有我师焉\"是结论。","hint":"\"焉\"是句末语气词。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5284","module":"intellect","type":"question","subtype":"fill_blank","grade_min":7,"grade_max":9,"difficulty":4,"tags":["chinese","文言文断句"],"subject":"chinese","stem":"\"予独爱莲之出淤泥而不染濯清涟而不妖\"断为：予独爱莲之出淤泥而不染/____。","stem_image":null,"options":null,"answer":"濯清涟而不妖","explanation":"两个\"而\"构成并列结构：出淤泥而不染/濯清涟而不妖。","hint":"找对称结构。","time_limit_seconds":25,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5285","module":"intellect","type":"question","subtype":"true_false","grade_min":7,"grade_max":9,"difficulty":3,"tags":["chinese","文言文断句"],"subject":"chinese","stem":"文言文断句时，\"者\"\"也\"\"矣\"\"哉\"\"乎\"等语气词通常出现在句末。","stem_image":null,"options":null,"answer":true,"explanation":"这些语气词是文言文断句的重要标志，通常出现在句子末尾。","hint":"想想这些字的作用。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5286","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":5,"tags":["chinese","文言文断句"],"subject":"chinese","stem":"\"夫战勇气也一鼓作气再而衰三而竭\"（《曹刿论战》）正确断句是？","stem_image":null,"options":[{"label":"A","text":"夫战/勇气也/一鼓作气/再而衰/三而竭"},{"label":"B","text":"夫/战勇气也/一鼓/作气再/而衰三而竭"},{"label":"C","text":"夫战勇/气也一/鼓作气/再而衰/三而竭"},{"label":"D","text":"夫战/勇气/也一鼓/作气再而/衰三而竭"}],"answer":"A","explanation":"\"夫战，勇气也\"是判断句。\"一鼓作气，再而衰，三而竭\"是三个并列分句。","hint":"找判断句\"...也\"和并列结构。","time_limit_seconds":30,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5287","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":3,"tags":["chinese","记叙文阅读"],"subject":"chinese","stem":"记叙文的六要素是？","stem_image":null,"options":[{"label":"A","text":"时间、地点、人物、起因、经过、结果"},{"label":"B","text":"论点、论据、论证、时间、地点、人物"},{"label":"C","text":"时间、地点、说明、描写、议论、抒情"},{"label":"D","text":"开头、发展、高潮、结尾、人物、事件"}],"answer":"A","explanation":"记叙文六要素：时间、地点、人物、事件的起因、经过和结果。","hint":"记叙文要交代清楚什么时候、在哪里、谁、做了什么事。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5288","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":4,"tags":["chinese","记叙文阅读"],"subject":"chinese","stem":"\"他的眼角湿润了，转过身去，不让我们看见他的泪水。\"这个句子属于什么描写？","stem_image":null,"options":[{"label":"A","text":"语言描写"},{"label":"B","text":"心理描写"},{"label":"C","text":"动作描写和神态描写"},{"label":"D","text":"环境描写"}],"answer":"C","explanation":"\"眼角湿润\"是神态描写，\"转过身去\"是动作描写。","hint":"有动作又有表情。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5289","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":4,"tags":["chinese","记叙文阅读"],"subject":"chinese","stem":"记叙文的叙述顺序不包括下面哪一种？","stem_image":null,"options":[{"label":"A","text":"顺叙"},{"label":"B","text":"倒叙"},{"label":"C","text":"插叙"},{"label":"D","text":"平叙"}],"answer":"D","explanation":"常见叙述顺序有顺叙、倒叙、插叙。\"平叙\"不是标准的叙述顺序术语（有些教材提及\"补叙\"但不包括\"平叙\"）。","hint":"记叙文常见的三种叙述顺序。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5290","module":"intellect","type":"question","subtype":"fill_blank","grade_min":7,"grade_max":9,"difficulty":3,"tags":["chinese","记叙文阅读"],"subject":"chinese","stem":"记叙文中，开头和结尾相互呼应的写法叫做____。","stem_image":null,"options":null,"answer":"首尾呼应","explanation":"文章开头提出的内容在结尾再次出现，形成前后呼应，使文章结构完整。","hint":"首尾之间的关系。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5291","module":"intellect","type":"question","subtype":"fill_blank","grade_min":7,"grade_max":9,"difficulty":4,"tags":["chinese","记叙文阅读"],"subject":"chinese","stem":"记叙文中，用某一具体事物来表达抽象情感或品质的手法叫做____。","stem_image":null,"options":null,"answer":"象征","explanation":"象征手法用具体事物代表抽象意义，如用梅花象征坚强。","hint":"用具体的事物暗示深层含义。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5292","module":"intellect","type":"question","subtype":"true_false","grade_min":7,"grade_max":9,"difficulty":3,"tags":["chinese","记叙文阅读"],"subject":"chinese","stem":"倒叙是把事件的结局或最精彩的部分放在开头写，然后再按时间顺序叙述。","stem_image":null,"options":null,"answer":true,"explanation":"倒叙就是先写结果或高潮，再回过头来写起因和经过，制造悬念吸引读者。","hint":"倒叙的\"倒\"指什么？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5293","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":5,"tags":["chinese","记叙文阅读"],"subject":"chinese","stem":"\"窗外的雨越下越大，他的心情也越来越沉重。\"这里环境描写的作用是？","stem_image":null,"options":[{"label":"A","text":"交代故事发生的地点"},{"label":"B","text":"烘托人物沉重的心情"},{"label":"C","text":"说明天气不好"},{"label":"D","text":"过渡到下一段"}],"answer":"B","explanation":"用大雨来烘托人物沉重的心情，是环境描写烘托人物心理的作用。","hint":"雨和心情之间有什么关系？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5294","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":3,"tags":["chinese","说明方法辨析"],"subject":"chinese","stem":"\"鲸的体重可达150吨，相当于30头大象的重量。\"用了什么说明方法？","stem_image":null,"options":[{"label":"A","text":"列数字和作比较"},{"label":"B","text":"打比方"},{"label":"C","text":"下定义"},{"label":"D","text":"分类别"}],"answer":"A","explanation":"\"150吨\"是列数字，\"相当于30头大象\"是作比较。两种方法结合使用。","hint":"有具体数字，还跟大象做了对比。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5295","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":4,"tags":["chinese","说明方法辨析"],"subject":"chinese","stem":"\"石拱桥的桥洞呈弧形，就像虹。\"用了什么说明方法？","stem_image":null,"options":[{"label":"A","text":"列数字"},{"label":"B","text":"打比方"},{"label":"C","text":"下定义"},{"label":"D","text":"举例子"}],"answer":"B","explanation":"\"就像虹\"把桥洞比作虹，是打比方（说明文中的比喻）。","hint":"\"像\"字是关键。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5296","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":4,"tags":["chinese","说明方法辨析"],"subject":"chinese","stem":"\"食物按照来源可分为植物性食物和动物性食物两大类。\"用了什么说明方法？","stem_image":null,"options":[{"label":"A","text":"分类别"},{"label":"B","text":"打比方"},{"label":"C","text":"作比较"},{"label":"D","text":"摹状貌"}],"answer":"A","explanation":"按来源把食物分为两类，这是分类别的说明方法。","hint":"\"分为...两大类\"是什么方法？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5297","module":"intellect","type":"question","subtype":"fill_blank","grade_min":7,"grade_max":9,"difficulty":3,"tags":["chinese","说明方法辨析"],"subject":"chinese","stem":"\"如赵州桥、卢沟桥就是著名的石拱桥。\"这句话用了____的说明方法。","stem_image":null,"options":null,"answer":"举例子","explanation":"列举赵州桥和卢沟桥作为石拱桥的具体例子，是举例子的说明方法。","hint":"举了两座桥作为例子。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5298","module":"intellect","type":"question","subtype":"fill_blank","grade_min":7,"grade_max":9,"difficulty":4,"tags":["chinese","说明方法辨析"],"subject":"chinese","stem":"\"统筹方法是一种安排工作进程的数学方法。\"这句话用了____的说明方法。","stem_image":null,"options":null,"answer":"下定义","explanation":"用简洁的语言揭示了统筹方法的本质特征，属于下定义。","hint":"\"...是...\"的格式揭示本质。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5299","module":"intellect","type":"question","subtype":"true_false","grade_min":7,"grade_max":9,"difficulty":3,"tags":["chinese","说明方法辨析"],"subject":"chinese","stem":"\"作比较\"和\"打比方\"是相同的说明方法。","stem_image":null,"options":null,"answer":false,"explanation":"\"作比较\"是将两个事物进行对比以突出特征，\"打比方\"是用比喻来形象说明。两者不同。","hint":"比较和比喻是一回事吗？","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5300","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":5,"tags":["chinese","说明方法辨析"],"subject":"chinese","stem":"\"这座塔占地面积300平方米，高55米，共十三层。\"这段文字主要运用了？","stem_image":null,"options":[{"label":"A","text":"列数字"},{"label":"B","text":"打比方"},{"label":"C","text":"举例子"},{"label":"D","text":"分类别"}],"answer":"A","explanation":"\"300平方米\"\"55米\"\"十三层\"都是具体数字，这是列数字的说明方法。","hint":"文中有大量数字。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5301","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":4,"tags":["chinese","议论文论点论据"],"subject":"chinese","stem":"下列哪个是事实论据？","stem_image":null,"options":[{"label":"A","text":"\"失败是成功之母\""},{"label":"B","text":"居里夫人经过无数次实验终于发现了镭"},{"label":"C","text":"\"书山有路勤为径\""},{"label":"D","text":"\"天才就是百分之九十九的汗水加百分之一的灵感\""}],"answer":"B","explanation":"事实论据是真实的事例。居里夫人发现镭是真实的历史事件。其他三个都是名言（道理论据）。","hint":"事实论据是具体的事例。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5302","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":4,"tags":["chinese","议论文论点论据"],"subject":"chinese","stem":"议论文的三要素是？","stem_image":null,"options":[{"label":"A","text":"论点、论据、论证"},{"label":"B","text":"论点、论据、结论"},{"label":"C","text":"论点、事例、引用"},{"label":"D","text":"论点、理由、方法"}],"answer":"A","explanation":"议论文三要素：论点（观点）、论据（证据）、论证（用论据证明论点的方法）。","hint":"三个都带\"论\"字。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5303","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":5,"tags":["chinese","议论文论点论据"],"subject":"chinese","stem":"\"司马迁受宫刑后忍辱发愤写出《史记》，说明逆境能磨炼人的意志。\"这段话中论点是？","stem_image":null,"options":[{"label":"A","text":"司马迁写了《史记》"},{"label":"B","text":"逆境能磨炼人的意志"},{"label":"C","text":"司马迁受了宫刑"},{"label":"D","text":"《史记》很有价值"}],"answer":"B","explanation":"\"逆境能磨炼人的意志\"是作者的观点（论点），司马迁的例子是论据。","hint":"论点是作者要论证的观点。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5304","module":"intellect","type":"question","subtype":"fill_blank","grade_min":7,"grade_max":9,"difficulty":3,"tags":["chinese","议论文论点论据"],"subject":"chinese","stem":"论据分为两类：事实论据和____论据。","stem_image":null,"options":null,"answer":"道理","explanation":"论据分为事实论据（具体事例、数据等）和道理论据（名言、定理、公理等）。","hint":"除了事实，还可以用什么来证明观点？","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5305","module":"intellect","type":"question","subtype":"fill_blank","grade_min":7,"grade_max":9,"difficulty":4,"tags":["chinese","议论文论点论据"],"subject":"chinese","stem":"常见的论证方法有举例论证、道理论证、对比论证和____论证。","stem_image":null,"options":null,"answer":"比喻","explanation":"四种常见论证方法：举例论证、道理论证、对比论证、比喻论证。","hint":"用比喻来论证叫什么？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5306","module":"intellect","type":"question","subtype":"true_false","grade_min":7,"grade_max":9,"difficulty":4,"tags":["chinese","议论文论点论据"],"subject":"chinese","stem":"议论文的中心论点只能出现在文章开头。","stem_image":null,"options":null,"answer":false,"explanation":"中心论点可以在开头、结尾或文中提出，也可以通过归纳得出。","hint":"论点只能在一个位置吗？","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5307","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":5,"tags":["chinese","议论文论点论据"],"subject":"chinese","stem":"\"有人说'近朱者赤，近墨者黑'，但周敦颐笔下的莲花'出淤泥而不染'，可见环境不能决定一切。\"这段话运用了哪种论证方法？","stem_image":null,"options":[{"label":"A","text":"举例论证"},{"label":"B","text":"对比论证"},{"label":"C","text":"比喻论证"},{"label":"D","text":"道理论证"}],"answer":"B","explanation":"将\"近朱者赤\"的观点和莲花\"出淤泥而不染\"进行对比，通过正反对比来论证观点，是对比论证。","hint":"两种相反的情况放在一起。","time_limit_seconds":25,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5308","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":3,"tags":["chinese","名篇默写"],"subject":"chinese","stem":"\"____，志在千里。烈士暮年，壮心不已。\"（曹操《龟虽寿》）","stem_image":null,"options":[{"label":"A","text":"老骥伏枥"},{"label":"B","text":"千里之行"},{"label":"C","text":"日月之行"},{"label":"D","text":"东临碣石"}],"answer":"A","explanation":"曹操《龟虽寿》：\"老骥伏枥，志在千里。烈士暮年，壮心不已。\"","hint":"老了的千里马。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5309","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":4,"tags":["chinese","名篇默写"],"subject":"chinese","stem":"\"先天下之忧而忧，____。\"（范仲淹《岳阳楼记》）","stem_image":null,"options":[{"label":"A","text":"后天下之乐而乐"},{"label":"B","text":"不以物喜不以己悲"},{"label":"C","text":"居庙堂之高则忧其民"},{"label":"D","text":"处江湖之远则忧其君"}],"answer":"A","explanation":"范仲淹《岳阳楼记》名句：\"先天下之忧而忧，后天下之乐而乐。\"","hint":"先...后...对称结构。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5310","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":4,"tags":["chinese","名篇默写"],"subject":"chinese","stem":"\"会当凌绝顶，____。\"（杜甫《望岳》）","stem_image":null,"options":[{"label":"A","text":"一览众山小"},{"label":"B","text":"只缘身在此山中"},{"label":"C","text":"千里江陵一日还"},{"label":"D","text":"白云生处有人家"}],"answer":"A","explanation":"杜甫《望岳》：\"会当凌绝顶，一览众山小。\"","hint":"登上最高峰后看到什么？","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5311","module":"intellect","type":"question","subtype":"fill_blank","grade_min":7,"grade_max":9,"difficulty":3,"tags":["chinese","名篇默写"],"subject":"chinese","stem":"\"海内存知己，____。\"（王勃《送杜少府之任蜀州》）","stem_image":null,"options":null,"answer":"天涯若比邻","explanation":"王勃名句：\"海内存知己，天涯若比邻。\"","hint":"表达友情不受距离影响。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
