  },
  {
    "id": "intellect_q_3061",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 5,
    "grade_max": 6,
    "difficulty": 3,
    "tags": ["关联词"],
    "subject": "chinese",
    "stem": "选择正确的关联词：____天气很冷，____他仍然坚持锻炼。",
    "options": [
      {"label": "A", "text": "因为……所以……"},
      {"label": "B", "text": "虽然……但是……"},
      {"label": "C", "text": "不但……而且……"},
      {"label": "D", "text": "如果……就……"}
    ],
    "answer": "B",
    "explanation": "天气冷和坚持锻炼之间是转折关系，用“虽然……但是……”。前半句是不利条件，后半句是出乎意料的结果。",
    "hint": "前后两句话是什么关系？相反还是因果？",
    "time_limit_seconds": 30,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_3062",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 5,
    "grade_max": 6,
    "difficulty": 3,
    "tags": ["关联词"],
    "subject": "chinese",
    "stem": "选择正确的关联词：____你认真学习，____能取得好成绩。",
    "options": [
      {"label": "A", "text": "虽然……但是……"},
      {"label": "B", "text": "不但……而且……"},
      {"label": "C", "text": "只要……就……"},
      {"label": "D", "text": "即使……也……"}
    ],
    "answer": "C",
    "explanation": "认真学习是条件，取得好成绩是结果。“只要……就……”表示充分条件关系，只要满足条件就能得到结果。",
    "hint": "前面是条件，后面是结果。",
    "time_limit_seconds": 30,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_3063",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 5,
    "grade_max": 6,
    "difficulty": 4,
    "tags": ["关联词"],
    "subject": "chinese",
    "stem": "下面哪个句子关联词使用正确？",
    "options": [
      {"label": "A", "text": "因为他学习好，但是老师表扬了他。"},
      {"label": "B", "text": "虽然他学习好，所以老师表扬了他。"},
      {"label": "C", "text": "不但他学习好，而且品德也好。"},
      {"label": "D", "text": "只要他学习好，但是品德也好。"}
    ],
    "answer": "C",
    "explanation": "“不但……而且……”表示递进关系，学习好和品德好是层层递进的。A和B搭配错误，D搭配错误。",
    "hint": "关联词要成对使用，搭配要正确。",
    "time_limit_seconds": 30,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_3064",
    "module": "intellect",
    "type": "question",
    "subtype": "fill_blank",
    "grade_min": 5,
    "grade_max": 6,
    "difficulty": 3,
    "tags": ["关联词"],
    "subject": "chinese",
    "stem": "填入合适的关联词：____明天下雨，运动会____延期举行。",
    "options": [],
    "answer": "如果……就……",
    "explanation": "“如果……就……”表示假设关系。如果明天下雨（假设条件），运动会就延期（假设结果）。",
    "hint": "前面是一种假设的情况。",
    "time_limit_seconds": 30,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_3065",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 5,
    "grade_max": 6,
    "difficulty": 4,
    "tags": ["关联词"],
    "subject": "chinese",
    "stem": "“即使遇到再大的困难，我们也不能放弃。”这句话中的关联词表示什么关系？",
    "options": [
      {"label": "A", "text": "因果关系"},
      {"label": "B", "text": "假设关系"},
      {"label": "C", "text": "转折关系"},
      {"label": "D", "text": "让步关系"}
    ],
    "answer": "D",
    "explanation": "“即使……也……”表示让步关系，即使假设的情况很极端，结果也不会改变。这是一种退一步说的语气。",
    "hint": "“即使……也……”先退一步承认条件，然后说结果不变。",
    "time_limit_seconds": 30,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_3066",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 5,
    "grade_max": 6,
    "difficulty": 3,
    "tags": ["病句修改"],
    "subject": "chinese",
    "stem": "下面哪个句子有语病？",
    "options": [
      {"label": "A", "text": "我们要养成讲卫生的好习惯。"},
      {"label": "B", "text": "经过努力，他的成绩有了很大提高。"},
      {"label": "C", "text": "我们必须认真克服并善于发现学习上的错误。"},
      {"label": "D", "text": "这本书的内容很丰富。"}
    ],
    "answer": "C",
    "explanation": "C句语序不当，应该先“发现”再“克服”，正确应为“我们必须善于发现并认真克服学习上的错误”。",
    "hint": "想一想，是先发现问题还是先克服问题？",
    "time_limit_seconds": 45,
    "points": 15,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_3067",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 5,
    "grade_max": 6,
    "difficulty": 4,
    "tags": ["病句修改"],
    "subject": "chinese",
    "stem": "“通过这次活动，使我受到了深刻的教育。”这个句子的病因是？",
    "options": [
      {"label": "A", "text": "用词不当"},
      {"label": "B", "text": "成分残缺（缺少主语）"},
      {"label": "C", "text": "语序不当"},
      {"label": "D", "text": "搭配不当"}
    ],
    "answer": "B",
    "explanation": "“通过”和“使”都是介词，把主语“我”变成了被动者，导致句子缺少主语。应该去掉“通过”或“使”。",
    "hint": "这个句子的主语是谁？谁受到了教育？",
    "time_limit_seconds": 45,
    "points": 15,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_3068",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 5,
    "grade_max": 6,
    "difficulty": 3,
    "tags": ["病句修改"],
    "subject": "chinese",
    "stem": "“他的作文水平有了明显的改善。”这句话的语病是？",
    "options": [
      {"label": "A", "text": "搭配不当"},
      {"label": "B", "text": "语序不当"},
      {"label": "C", "text": "成分残缺"},
      {"label": "D", "text": "没有语病"}
    ],
    "answer": "A",
    "explanation": "“水平”应该和“提高”搭配，不能和“改善”搭配。应改为“他的作文水平有了明显的提高”。",
    "hint": "水平可以“提高”，条件可以“改善”。",
    "time_limit_seconds": 45,
    "points": 15,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_3069",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 5,
    "grade_max": 6,
    "difficulty": 4,
    "tags": ["病句修改"],
    "subject": "chinese",
    "stem": "“全校师生和班主任都参加了这次活动。”这句话有什么问题？",
    "options": [
      {"label": "A", "text": "语序不当"},
      {"label": "B", "text": "不合逻辑（概念包含）"},
      {"label": "C", "text": "搭配不当"},
      {"label": "D", "text": "成分残缺"}
    ],
    "answer": "B",
    "explanation": "“全校师生”已经包含了“班主任”，再单独列出“班主任”就不合逻辑了。应改为“全校师生都参加了这次活动”。",
    "hint": "班主任属于“全校师生”中的一部分吗？",
    "time_limit_seconds": 45,
    "points": 15,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_3070",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 5,
    "grade_max": 6,
    "difficulty": 4,
    "tags": ["病句修改"],
    "subject": "chinese",
    "stem": "“我们要防止类似事故不再发生。”修改正确的是？",
    "options": [
      {"label": "A", "text": "我们要防止类似事故再发生。"},
      {"label": "B", "text": "我们要防止类似事故不发生。"},
      {"label": "C", "text": "我们要类似事故不再发生。"},
      {"label": "D", "text": "我们不要防止类似事故再发生。"}
    ],
    "answer": "A",
    "explanation": "原句“防止”和“不再发生”构成双重否定，意思变成了“让事故发生”，与本意相反。应去掉“不”字。",
    "hint": "“防止”本身已经含有否定的意思。",
    "time_limit_seconds": 45,
    "points": 15,
    "version": 1,
    "created_at": "2026-03-27",
