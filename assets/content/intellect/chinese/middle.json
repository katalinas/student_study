    ],
    "subject": "chinese",
    "stem": "“美丽”的近义词是下面哪一个？",
    "stem_image": null,
    "options": [
      {
        "label": "A",
        "text": "丑陋"
      },
      {
        "label": "B",
        "text": "漂亮"
      },
      {
        "label": "C",
        "text": "普通"
      },
      {
        "label": "D",
        "text": "难看"
      }
    ],
    "answer": "B",
    "explanation": "“美丽”和“漂亮”都表示好看、外形出众，是一对近义词。而“丑陋”“难看”是它的反义词。",
    "hint": "近义词是意思相近的词，想想哪个词和“美丽”意思差不多。",
    "time_limit_seconds": 25,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_1103",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
