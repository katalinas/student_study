    "left_items": [
      {
        "id": "L1",
        "text": "太阳像一个大火球。"
      },
      {
        "id": "L2",
        "text": "小鸟在枝头唱着欢快的歌。"
      },
      {
        "id": "L3",
        "text": "飞流直下三千尺。"
      },
      {
        "id": "L4",
        "text": "他跑得比兔子还快。"
