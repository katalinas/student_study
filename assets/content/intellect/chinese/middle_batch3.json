[
  {"id":"intellect_q_5245","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":2,"tags":["chinese","多音字"],"subject":"chinese","stem":"\"他干了一件好事\"中\"干\"的正确读音是？","stem_image":null,"options":[{"label":"A","text":"gàn"},{"label":"B","text":"gān"},{"label":"C","text":"gǎn"},{"label":"D","text":"gán"}],"answer":"A","explanation":"\"干\"在\"做、办\"的意思时读gàn，如干活、干事。在\"干燥\"时读gān。","hint":"想想这里\"干\"是什么意思。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5246","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":2,"tags":["chinese","多音字"],"subject":"chinese","stem":"\"音乐\"的\"乐\"和\"快乐\"的\"乐\"读音？","stem_image":null,"options":[{"label":"A","text":"都读lè"},{"label":"B","text":"都读yuè"},{"label":"C","text":"前yuè后lè"},{"label":"D","text":"前lè后yuè"}],"answer":"C","explanation":"\"音乐\"的\"乐\"读yuè（与音乐有关），\"快乐\"的\"乐\"读lè（高兴的意思）。","hint":"和音乐有关读什么？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5247","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":3,"tags":["chinese","多音字"],"subject":"chinese","stem":"下列句子中\"行\"的读音与其他三个不同的是？","stem_image":null,"options":[{"label":"A","text":"银行（háng）"},{"label":"B","text":"行列（háng）"},{"label":"C","text":"行走（xíng）"},{"label":"D","text":"行业（háng）"}],"answer":"C","explanation":"\"行走\"的\"行\"读xíng（走路的意思），其余三个都读háng。","hint":"表示走路时读什么？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5248","module":"intellect","type":"question","subtype":"fill_blank","grade_min":3,"grade_max":4,"difficulty":2,"tags":["chinese","多音字"],"subject":"chinese","stem":"\"还\"有两个读音：huán和hái。\"还书\"读____，\"还有\"读____。","stem_image":null,"options":null,"answer":"huán，hái","explanation":"\"还书\"的\"还\"是归还的意思，读huán。\"还有\"的\"还\"是仍然的意思，读hái。","hint":"归还读什么？仍然读什么？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5249","module":"intellect","type":"question","subtype":"fill_blank","grade_min":3,"grade_max":4,"difficulty":3,"tags":["chinese","多音字"],"subject":"chinese","stem":"\"大都市\"中\"都\"读____，\"都来了\"中\"都\"读____。","stem_image":null,"options":null,"answer":"dū，dōu","explanation":"\"大都市\"指大城市，读dū。\"都来了\"表示全部，读dōu。","hint":"表示城市读什么？表示全部读什么？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5250","module":"intellect","type":"question","subtype":"true_false","grade_min":3,"grade_max":4,"difficulty":2,"tags":["chinese","多音字"],"subject":"chinese","stem":"\"好学\"（爱学习）和\"好人\"（善良的人）中的\"好\"读音相同。","stem_image":null,"options":null,"answer":false,"explanation":"\"好学\"的\"好\"读hào（爱好、喜欢），\"好人\"的\"好\"读hǎo（善良的）。","hint":"一个是爱好的意思，一个是好坏的意思。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5251","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":3,"tags":["chinese","多音字"],"subject":"chinese","stem":"\"朝阳\"读cháo yáng时指？","stem_image":null,"options":[{"label":"A","text":"面向太阳"},{"label":"B","text":"早晨的太阳"},{"label":"C","text":"一个地名"},{"label":"D","text":"太阳落山"}],"answer":"A","explanation":"\"朝（cháo）阳\"意为面向太阳。\"朝（zhāo）阳\"则指早晨的太阳。","hint":"cháo有朝向的意思。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5252","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":2,"tags":["chinese","修改病句"],"subject":"chinese","stem":"\"我们要注意不要粗心大意。\"这句话的毛病是？","stem_image":null,"options":[{"label":"A","text":"语义重复"},{"label":"B","text":"用词不当"},{"label":"C","text":"缺少主语"},{"label":"D","text":"没有毛病"}],"answer":"A","explanation":"\"注意不要\"和\"粗心大意\"意思重复了。可以改为\"我们不要粗心大意\"或\"我们要注意细心\"。","hint":"\"注意\"和后面的词有没有重复？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5253","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":2,"tags":["chinese","修改病句"],"subject":"chinese","stem":"下面哪句话没有语病？","stem_image":null,"options":[{"label":"A","text":"他的成绩有了明显的增加。"},{"label":"B","text":"他的成绩有了明显的提高。"},{"label":"C","text":"他的成绩有了明显的扩大。"},{"label":"D","text":"他的成绩有了明显的上涨。"}],"answer":"B","explanation":"\"成绩\"可以\"提高\"，不能\"增加、扩大、上涨\"。注意搭配。","hint":"\"成绩\"和什么词搭配最合适？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5254","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":3,"tags":["chinese","修改病句"],"subject":"chinese","stem":"\"全班同学都去了，只有小明没去。\"这句话的毛病是？","stem_image":null,"options":[{"label":"A","text":"前后矛盾"},{"label":"B","text":"成分残缺"},{"label":"C","text":"语序不当"},{"label":"D","text":"用词不当"}],"answer":"A","explanation":"\"全班同学都去了\"和\"只有小明没去\"互相矛盾。应改为\"除了小明，全班同学都去了\"。","hint":"\"都\"和\"只有...没去\"是否矛盾？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5255","module":"intellect","type":"question","subtype":"fill_blank","grade_min":3,"grade_max":4,"difficulty":2,"tags":["chinese","修改病句"],"subject":"chinese","stem":"病句：\"他穿了一件新的漂亮衣服。\"修改后：他穿了一件____。","stem_image":null,"options":null,"answer":"漂亮的新衣服","explanation":"多项定语排列顺序：表状态的\"漂亮的\"放在表新旧的\"新\"前面。应改为\"漂亮的新衣服\"。","hint":"形容词的顺序要注意。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5256","module":"intellect","type":"question","subtype":"fill_blank","grade_min":3,"grade_max":4,"difficulty":3,"tags":["chinese","修改病句"],"subject":"chinese","stem":"修改病句：\"经过老师的帮助，使我进步很大。\"→____。","stem_image":null,"options":null,"answer":"经过老师的帮助，我进步很大","explanation":"原句缺主语，\"经过\"和\"使\"不能同时使用。去掉\"使\"，让\"我\"做主语。","hint":"\"经过...使...\"去掉一个。","time_limit_seconds":25,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5257","module":"intellect","type":"question","subtype":"true_false","grade_min":3,"grade_max":4,"difficulty":2,"tags":["chinese","修改病句"],"subject":"chinese","stem":"\"他大约用了差不多一个小时。\"这句话没有语病。","stem_image":null,"options":null,"answer":false,"explanation":"\"大约\"和\"差不多\"语义重复，应去掉一个：\"他大约用了一个小时\"或\"他用了差不多一个小时\"。","hint":"看看有没有意思重复的词。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5258","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":3,"tags":["chinese","修改病句"],"subject":"chinese","stem":"\"春天的杭州是一年四季中最美的季节。\"病句类型是？","stem_image":null,"options":[{"label":"A","text":"搭配不当"},{"label":"B","text":"语义重复"},{"label":"C","text":"成分残缺"},{"label":"D","text":"语序不当"}],"answer":"A","explanation":"\"杭州\"是地方，不是\"季节\"，主宾搭配不当。应改为\"杭州的春天是一年四季中最美的季节\"或\"春天的杭州是一年四季中最美的\"。","hint":"杭州是季节吗？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5259","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":2,"tags":["chinese","缩句扩句进阶"],"subject":"chinese","stem":"\"美丽的蝴蝶在花丛中翩翩起舞。\"缩句后是？","stem_image":null,"options":[{"label":"A","text":"蝴蝶起舞。"},{"label":"B","text":"美丽的蝴蝶起舞。"},{"label":"C","text":"蝴蝶翩翩起舞。"},{"label":"D","text":"蝴蝶在花丛中飞。"}],"answer":"A","explanation":"缩句去掉修饰成分：去\"美丽的\"(定语)、\"在花丛中\"(状语)、\"翩翩\"(状语)，剩余\"蝴蝶起舞\"。","hint":"去掉所有修饰词。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5260","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":3,"tags":["chinese","缩句扩句进阶"],"subject":"chinese","stem":"\"妈妈做饭。\"扩句后最好的是？","stem_image":null,"options":[{"label":"A","text":"妈妈在厨房里做饭做饭。"},{"label":"B","text":"我的妈妈在明亮的厨房里做着可口的饭菜。"},{"label":"C","text":"妈妈做了。"},{"label":"D","text":"妈妈。"}],"answer":"B","explanation":"扩句要加修饰词使句子更具体、生动。B加了定语\"我的\"\"明亮的\"\"可口的\"和状语\"在厨房里\"。","hint":"扩句就是给主语、谓语、宾语加修饰词。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5261","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":2,"tags":["chinese","缩句扩句进阶"],"subject":"chinese","stem":"\"勤劳的蜜蜂在金黄的花海中忙碌地采蜜。\"缩到最简是？","stem_image":null,"options":[{"label":"A","text":"蜜蜂采蜜。"},{"label":"B","text":"勤劳的蜜蜂采蜜。"},{"label":"C","text":"蜜蜂忙碌地采蜜。"},{"label":"D","text":"蜜蜂在花海中采蜜。"}],"answer":"A","explanation":"去掉所有定语、状语后，最简形式为\"蜜蜂采蜜\"（主语+谓语+宾语）。","hint":"只保留谁做什么。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5262","module":"intellect","type":"question","subtype":"fill_blank","grade_min":3,"grade_max":4,"difficulty":2,"tags":["chinese","缩句扩句进阶"],"subject":"chinese","stem":"缩句：\"可爱的小鸟在高高的树枝上唱着动听的歌。\"→____。","stem_image":null,"options":null,"answer":"小鸟唱歌","explanation":"去掉定语\"可爱的\"\"高高的\"\"动听的\"，去掉状语\"在树枝上\"，缩为\"小鸟唱歌\"。","hint":"去掉\"的\"字前面的和\"在...上\"。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5263","module":"intellect","type":"question","subtype":"fill_blank","grade_min":3,"grade_max":4,"difficulty":3,"tags":["chinese","缩句扩句进阶"],"subject":"chinese","stem":"扩句：\"风吹。\"至少加两个修饰词→____。","stem_image":null,"options":null,"answer":"温暖的春风轻轻地吹","explanation":"给\"风\"加定语\"温暖的春\"，给\"吹\"加状语\"轻轻地\"。（答案不唯一，合理即可）","hint":"什么样的风怎样地吹？","time_limit_seconds":25,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5264","module":"intellect","type":"question","subtype":"true_false","grade_min":3,"grade_max":4,"difficulty":2,"tags":["chinese","缩句扩句进阶"],"subject":"chinese","stem":"缩句时，\"把\"字句和\"被\"字句中的\"把\"和\"被\"部分要保留。","stem_image":null,"options":null,"answer":false,"explanation":"缩句时可以去掉\"把\"和\"被\"的部分。如\"小猫把鱼吃了\"缩为\"小猫吃了鱼\"。","hint":"\"把\"和\"被\"是不是修饰成分？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5265","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":3,"tags":["chinese","缩句扩句进阶"],"subject":"chinese","stem":"\"机灵的猴子迅速地爬上了高大的椰子树。\"缩句为？","stem_image":null,"options":[{"label":"A","text":"猴子爬树。"},{"label":"B","text":"猴子爬上了树。"},{"label":"C","text":"机灵的猴子爬树。"},{"label":"D","text":"猴子迅速爬树。"}],"answer":"B","explanation":"缩句保留主干：主语\"猴子\"+谓语\"爬上了\"+宾语\"树\"。\"了\"是助词应保留，\"爬上\"是动补结构不拆分。","hint":"\"爬上了\"是谓语的完整表达。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5266","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":2,"tags":["chinese","阅读理解"],"subject":"chinese","stem":"读文段：\"小蚂蚁发现了一块大面包，它搬不动，就回去叫来了很多同伴，大家一起把面包搬回了家。\"这个故事告诉我们什么道理？","stem_image":null,"options":[{"label":"A","text":"蚂蚁力气很大"},{"label":"B","text":"团结力量大"},{"label":"C","text":"面包很好吃"},{"label":"D","text":"蚂蚁跑得快"}],"answer":"B","explanation":"一只蚂蚁搬不动，很多蚂蚁一起就搬动了，说明团结力量大。","hint":"一只蚂蚁和很多蚂蚁的对比。","time_limit_seconds":30,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5267","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":3,"tags":["chinese","阅读理解"],"subject":"chinese","stem":"读文段：\"春天的早晨，小草从泥土里探出了脑袋，好奇地打量着这个世界。\"这里用了什么修辞手法？","stem_image":null,"options":[{"label":"A","text":"比喻"},{"label":"B","text":"拟人"},{"label":"C","text":"夸张"},{"label":"D","text":"排比"}],"answer":"B","explanation":"\"探出脑袋\"\"好奇地打量\"把小草当人来写，赋予小草人的动作和心理，是拟人手法。","hint":"小草真的有\"脑袋\"和\"好奇\"吗？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5268","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":3,"tags":["chinese","阅读理解"],"subject":"chinese","stem":"读文段：\"老师说：'失败是成功之母。'小明听了老师的话，不再灰心，继续努力。\"\"失败是成功之母\"的意思是？","stem_image":null,"options":[{"label":"A","text":"失败的人不会成功"},{"label":"B","text":"从失败中吸取教训可以走向成功"},{"label":"C","text":"成功后会失败"},{"label":"D","text":"母亲不会失败"}],"answer":"B","explanation":"这句名言的意思是每次失败都可以从中学到东西，为下次成功打好基础。","hint":"失败和成功是什么关系？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5269","module":"intellect","type":"question","subtype":"fill_blank","grade_min":3,"grade_max":4,"difficulty":2,"tags":["chinese","阅读理解"],"subject":"chinese","stem":"文段：\"妈妈每天很早就起床，为我们做早饭，送我们上学，然后再去上班。\"从这段话可以看出妈妈是一个____的人。","stem_image":null,"options":null,"answer":"勤劳","explanation":"妈妈很早起床做早饭、送孩子、再上班，说明她非常勤劳辛苦。","hint":"每天做这么多事说明什么？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5270","module":"intellect","type":"question","subtype":"fill_blank","grade_min":3,"grade_max":4,"difficulty":3,"tags":["chinese","阅读理解"],"subject":"chinese","stem":"\"书山有路勤为径，学海无涯苦作舟。\"这副对联告诫我们学习要____。","stem_image":null,"options":null,"answer":"勤奋刻苦","explanation":"\"勤为径\"说要勤奋，\"苦作舟\"说要刻苦，整句话勉励我们勤奋刻苦地学习。","hint":"\"勤\"和\"苦\"是关键字。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5271","module":"intellect","type":"question","subtype":"true_false","grade_min":3,"grade_max":4,"difficulty":2,"tags":["chinese","阅读理解"],"subject":"chinese","stem":"\"他像一只受惊的小鸟，飞快地跑走了。\"这句话用了比喻的修辞手法。","stem_image":null,"options":null,"answer":true,"explanation":"用\"像\"把\"他\"比作\"受惊的小鸟\"，是比喻（明喻）。","hint":"\"像\"是什么修辞的标志词？","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5272","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":3,"tags":["chinese","阅读理解"],"subject":"chinese","stem":"读文段：\"乌鸦喝水的故事告诉我们，遇到困难要开动脑筋，想办法解决。\"这段话的中心意思是？","stem_image":null,"options":[{"label":"A","text":"乌鸦很聪明"},{"label":"B","text":"遇到困难要动脑筋"},{"label":"C","text":"水很好喝"},{"label":"D","text":"石子很有用"}],"answer":"B","explanation":"文段明确说明了故事告诉我们遇到困难要开动脑筋想办法。","hint":"直接从文段中找中心句。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5273","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":2,"tags":["chinese","古诗填空"],"subject":"chinese","stem":"\"床前明月光，疑是地上____。\"（李白《静夜思》）","stem_image":null,"options":[{"label":"A","text":"霜"},{"label":"B","text":"雪"},{"label":"C","text":"冰"},{"label":"D","text":"露"}],"answer":"A","explanation":"李白《静夜思》：\"床前明月光，疑是地上霜。\"","hint":"月光像什么铺在地上？","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5274","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":2,"tags":["chinese","古诗填空"],"subject":"chinese","stem":"\"____细无声\"的上一句是？","stem_image":null,"options":[{"label":"A","text":"随风潜入夜"},{"label":"B","text":"好雨知时节"},{"label":"C","text":"当春乃发生"},{"label":"D","text":"野径云俱黑"}],"answer":"A","explanation":"杜甫《春夜喜雨》：\"随风潜入夜，润物细无声。\"","hint":"想想这首描写春雨的诗。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5275","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":3,"tags":["chinese","古诗填空"],"subject":"chinese","stem":"\"不识庐山真面目，只缘身在此山中\"出自哪位诗人？","stem_image":null,"options":[{"label":"A","text":"李白"},{"label":"B","text":"杜甫"},{"label":"C","text":"苏轼"},{"label":"D","text":"白居易"}],"answer":"C","explanation":"这两句出自苏轼的《题西林壁》。","hint":"《题西林壁》的作者。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5276","module":"intellect","type":"question","subtype":"fill_blank","grade_min":3,"grade_max":4,"difficulty":2,"tags":["chinese","古诗填空"],"subject":"chinese","stem":"\"两岸猿声啼不住，____。\"（李白《早发白帝城》）","stem_image":null,"options":null,"answer":"轻舟已过万重山","explanation":"李白《早发白帝城》：\"两岸猿声啼不住，轻舟已过万重山。\"","hint":"船在长江上快速行驶。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5277","module":"intellect","type":"question","subtype":"fill_blank","grade_min":3,"grade_max":4,"difficulty":3,"tags":["chinese","古诗填空"],"subject":"chinese","stem":"\"____，万条垂下绿丝绦。\"（贺知章《咏柳》）","stem_image":null,"options":null,"answer":"碧玉妆成一树高","explanation":"贺知章《咏柳》：\"碧玉妆成一树高，万条垂下绿丝绦。\"","hint":"用碧玉比喻柳树。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5278","module":"intellect","type":"question","subtype":"true_false","grade_min":3,"grade_max":4,"difficulty":2,"tags":["chinese","古诗填空"],"subject":"chinese","stem":"\"举头望明月，低头思故乡\"表达了诗人对家乡的思念之情。","stem_image":null,"options":null,"answer":true,"explanation":"这两句出自李白《静夜思》，通过望月表达对故乡的思念。","hint":"\"思故乡\"是什么意思？","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5279","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":3,"tags":["chinese","古诗填空"],"subject":"chinese","stem":"\"独在异乡为异客，每逢佳节倍思亲\"中的\"佳节\"指的是？","stem_image":null,"options":[{"label":"A","text":"春节"},{"label":"B","text":"中秋节"},{"label":"C","text":"重阳节"},{"label":"D","text":"端午节"}],"answer":"C","explanation":"这首诗是王维的《九月九日忆山东兄弟》，\"九月九日\"就是重阳节。","hint":"看诗题中的日期。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"}
