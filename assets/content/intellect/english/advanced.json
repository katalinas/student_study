  {
    "id": "intellect_q_1710",
    "module": "intellect",
    "type": "question",
    "subtype": "true_false",
    "grade_min": 7,
    "grade_max": 9,
    "difficulty": 3,
    "tags": [
      "english",
      "现在完成时"
    ],
    "subject": "english",
    "stem": "\"I have gone to Beijing\" and \"I have been to Beijing\" have the same meaning. (\"I have gone to Beijing\" 和 \"I have been to Beijing\" 意思相同。)",
    "stem_image": null,
    "options": [
      {
        "label": "A",
        "text": "正确 (True)"
      },
      {
        "label": "B",
        "text": "错误 (False)"
      }
    ],
    "answer": "B",
    "explanation": "错误。这两句意思不同。\"I have gone to Beijing\" 意思是\"我去了北京（人还在北京，没有回来）\"。\"I have been to Beijing\" 意思是\"我去过北京（有过这个经历，人已经回来了）\"。",
    "hint": "have gone to 和 have been to 是现在完成时的两个重要短语，它们的意思有区别。",
    "time_limit_seconds": 30,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_1711",
    "module": "intellect",
    "type": "question",
    "subtype": "true_false",
    "grade_min": 7,
    "grade_max": 9,
    "difficulty": 4,
    "tags": [
      "english",
      "被动语态"
    ],
    "subject": "english",
    "stem": "The sentence \"The cake was ate by Tom\" is grammatically correct. (句子 \"The cake was ate by Tom\" 语法正确。)",
    "stem_image": null,
    "options": [
      {
        "label": "A",
        "text": "正确 (True)"
      },
      {
        "label": "B",
        "text": "错误 (False)"
      }
    ],
    "answer": "B",
    "explanation": "错误。被动语态的结构是 \"be + 过去分词\"，eat 的过去分词是 eaten（不是 ate，ate 是过去式）。正确的句子应该是 \"The cake was eaten by Tom.\"（蛋糕被 Tom 吃了。）",
    "hint": "被动语态需要用过去分词，不是过去式。eat 的三种形式是：eat - ate - eaten。",
    "time_limit_seconds": 30,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  }
