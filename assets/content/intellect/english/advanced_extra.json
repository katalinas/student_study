  },
  {
    "id": "intellect_q_3179",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 7,
    "grade_max": 9,
    "difficulty": 5,
    "tags": ["宾语从句", "语法"],
    "subject": "english",
    "stem": "下面哪个句子的宾语从句语序正确？",
    "options": [
      {"label": "A", "text": "I want to know where does he live."},
      {"label": "B", "text": "I want to know where he lives."},
      {"label": "C", "text": "I want to know where he does live."},
      {"label": "D", "text": "I want to know he lives where."}
    ],
    "answer": "B",
    "explanation": "宾语从句必须用陈述语序（主语+谓语），不能用疑问语序。正确：where he lives。",
    "hint": "宾语从句用陈述语序。",
    "time_limit_seconds": 30,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_3180",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 7,
    "grade_max": 9,
    "difficulty": 4,
    "tags": ["状语从句", "语法"],
    "subject": "english",
    "stem": "选择正确答案：____ it rains tomorrow, we will stay at home.",
    "options": [
      {"label": "A", "text": "If"},
      {"label": "B", "text": "Because"},
      {"label": "C", "text": "Although"},
      {"label": "D", "text": "When"}
    ],
    "answer": "A",
    "explanation": "“如果明天下雨，我们就待在家里。”If引导条件状语从句。注意：主将从现——主句用将来时，从句用一般现在时。",
    "hint": "“如果”用什么引导词？",
    "time_limit_seconds": 30,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_3181",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 7,
    "grade_max": 9,
    "difficulty": 4,
    "tags": ["状语从句", "语法"],
    "subject": "english",
    "stem": "选择正确答案：____ he was tired, he kept working.",
    "options": [
      {"label": "A", "text": "If"},
      {"label": "B", "text": "Because"},
      {"label": "C", "text": "Although"},
      {"label": "D", "text": "So"}
    ],
    "answer": "C",
    "explanation": "“虽然他很累，他仍然继续工作。”Although引导让步状语从句，表示“虽然”。注意：although不能和but同时使用。",
    "hint": "前后两句是转折关系。",
    "time_limit_seconds": 30,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_3182",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 7,
    "grade_max": 9,
    "difficulty": 4,
    "tags": ["状语从句", "语法"],
    "subject": "english",
    "stem": "“主将从现”规则是什么意思？",
    "options": [
      {"label": "A", "text": "主句用现在时，从句用将来时"},
      {"label": "B", "text": "主句用将来时，从句用现在时"},
      {"label": "C", "text": "主句和从句都用将来时"},
      {"label": "D", "text": "主句和从句都用现在时"}
    ],
    "answer": "B",
    "explanation": "在条件状语从句（if）和时间状语从句（when/before/after/until）中，主句用一般将来时，从句用一般现在时代替将来时。",
    "hint": "“主将从现”中“主”是主句，“从”是从句。",
    "time_limit_seconds": 30,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_3183",
    "module": "intellect",
    "type": "question",
    "subtype": "fill_blank",
    "grade_min": 7,
    "grade_max": 9,
    "difficulty": 4,
    "tags": ["状语从句", "语法"],
    "subject": "english",
    "stem": "I will call you ____ I arrive home.（填入合适的连词）",
    "options": [],
    "answer": "when",
    "explanation": "“我到家的时候会给你打电话。”when引导时间状语从句。注意主将从现：主句will call（将来时），从句arrive（现在时）。",
    "hint": "这里需要一个表示“当……时候”的词。",
    "time_limit_seconds": 30,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_3184",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 7,
    "grade_max": 9,
    "difficulty": 5,
    "tags": ["状语从句", "语法"],
    "subject": "english",
    "stem": "下面哪个句子语法正确？",
    "options": [
      {"label": "A", "text": "If it will rain, I will stay home."},
      {"label": "B", "text": "If it rains, I will stay home."},
      {"label": "C", "text": "Although he is tired, but he works hard."},
      {"label": "D", "text": "Because he was sick, so he didn't come."}
    ],
    "answer": "B",
    "explanation": "B遵循了主将从现原则。A从句不能用will；C中although和but不能同时用；D中because和so不能同时用。",
    "hint": "注意关联词不能重复使用。",
    "time_limit_seconds": 30,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_3185",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 7,
    "grade_max": 9,
    "difficulty": 4,
    "tags": ["过去进行时", "语法"],
    "subject": "english",
    "stem": "选择正确答案：I ____ TV when she called me.",
    "options": [
      {"label": "A", "text": "watch"},
      {"label": "B", "text": "watched"},
      {"label": "C", "text": "was watching"},
      {"label": "D", "text": "am watching"}
    ],
    "answer": "C",
    "explanation": "过去进行时表示过去某个时刻正在进行的动作。“当她打电话给我时，我正在看电视。”结构：was/were + doing。",
    "hint": "“当……的时候正在做……”用过去进行时。",
    "time_limit_seconds": 30,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_3186",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 7,
    "grade_max": 9,
    "difficulty": 4,
    "tags": ["过去进行时", "语法"],
    "subject": "english",
    "stem": "过去进行时的构成是？",
    "options": [
      {"label": "A", "text": "was/were + 动词原形"},
      {"label": "B", "text": "was/were + 动词过去式"},
      {"label": "C", "text": "was/were + 现在分词（V-ing）"},
      {"label": "D", "text": "did + 动词原形"}
    ],
    "answer": "C",
    "explanation": "过去进行时的构成是was/were + 现在分词（V-ing）。例如：I was reading.（我当时正在读书。）",
    "hint": "进行时态都要用V-ing形式。",
    "time_limit_seconds": 20,
    "points": 5,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_3187",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 7,
    "grade_max": 9,
    "difficulty": 4,
    "tags": ["过去进行时", "语法"],
    "subject": "english",
    "stem": "选择正确答案：They ____ dinner at 7 o'clock last night.",
