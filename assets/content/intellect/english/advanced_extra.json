[
  {
    "id": "intellect_q_3175",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 7,
    "grade_max": 9,
    "difficulty": 4,
    "tags": ["宾语从句", "语法"],
    "subject": "english",
    "stem": "选择正确答案：I don't know ____ he will come tomorrow.",
    "options": [
      {"label": "A", "text": "that"},
      {"label": "B", "text": "if"},
      {"label": "C", "text": "what"},
      {"label": "D", "text": "which"}
    ],
    "answer": "B",
    "explanation": "当宾语从句表示“是否”时，用if或whether引导。这里意为“我不知道他明天是否会来”。",
    "hint": "“是否”用什么引导词？",
    "time_limit_seconds": 30,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_3176",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 7,
    "grade_max": 9,
    "difficulty": 4,
    "tags": ["宾语从句", "语法"],
    "subject": "english",
    "stem": "宾语从句中，主句是过去时，从句应该用什么时态？",
    "options": [
      {"label": "A", "text": "一般现在时"},
      {"label": "B", "text": "相应的过去时态"},
      {"label": "C", "text": "一般将来时"},
      {"label": "D", "text": "任何时态都可以"}
    ],
    "answer": "B",
    "explanation": "宾语从句要遵循时态一致原则：主句是过去时，从句一般用相应的过去时态（一般过去时、过去进行时、过去将来时等）。但客观真理除外。",
    "hint": "这叫做“时态一致”原则。",
    "time_limit_seconds": 30,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_3177",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 7,
    "grade_max": 9,
    "difficulty": 4,
    "tags": ["宾语从句", "语法"],
    "subject": "english",
    "stem": "选择正确答案：Could you tell me ____ the nearest hospital is?",
    "options": [
      {"label": "A", "text": "where"},
      {"label": "B", "text": "what"},
      {"label": "C", "text": "which"},
      {"label": "D", "text": "who"}
    ],
    "answer": "A",
    "explanation": "问“最近的医院在哪里”，用where引导宾语从句。注意宾语从句要用陈述语序。",
    "hint": "问地点用什么引导词？",
    "time_limit_seconds": 30,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_3178",
    "module": "intellect",
    "type": "question",
    "subtype": "fill_blank",
    "grade_min": 7,
    "grade_max": 9,
    "difficulty": 4,
    "tags": ["宾语从句", "语法"],
    "subject": "english",
    "stem": "He asked me ____ I liked music.（填入引导词）",
    "options": [],
    "answer": "if",
    "explanation": "他问我是否喜欢音乐。表示“是否”用if或whether引导宾语从句。",
    "hint": "他问的是一个“是”或“否”的问题。",
    "time_limit_seconds": 30,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
