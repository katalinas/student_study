    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 5,
    "grade_max": 6,
    "difficulty": 3,
    "tags": ["频率副词", "语法"],
    "subject": "english",
    "stem": "频率副词通常放在句子的什么位置？",
    "options": [
      {"label": "A", "text": "句子开头"},
      {"label": "B", "text": "句子末尾"},
      {"label": "C", "text": "be动词之后，行为动词之前"},
      {"label": "D", "text": "任何位置都可以"}
    ],
    "answer": "C",
    "explanation": "频率副词放在be动词之后（She is always happy.），行为动词之前（He often plays football.）。",
    "hint": "例如：She is always late. He often reads.",
    "time_limit_seconds": 30,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
