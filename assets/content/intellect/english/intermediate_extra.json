    "grade_max": 6,
    "difficulty": 3,
    "tags": ["频率副词", "语法"],
    "subject": "english",
    "stem": "频率副词“always”的意思是？",
    "options": [
      {"label": "A", "text": "从不"},
      {"label": "B", "text": "有时"},
      {"label": "C", "text": "总是"},
      {"label": "D", "text": "很少"}
    ],
    "answer": "C",
    "explanation": "always是总是（100%频率），usually是通常（80%），sometimes是有时（50%），never是从不（0%）。",
    "hint": "这个副词表示频率最高。",
    "time_limit_seconds": 20,
    "points": 5,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
