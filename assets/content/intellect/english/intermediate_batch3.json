[
  {"id":"intellect_q_5350","module":"intellect","type":"question","subtype":"choice","grade_min":5,"grade_max":6,"difficulty":2,"tags":["english","现在进行时"],"subject":"english","stem":"Look! The children ____ in the park.","stem_image":null,"options":[{"label":"A","text":"play"},{"label":"B","text":"plays"},{"label":"C","text":"are playing"},{"label":"D","text":"played"}],"answer":"C","explanation":"Look!表示正在发生的动作，用现在进行时are playing。","hint":"Look!提示用现在进行时。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5351","module":"intellect","type":"question","subtype":"choice","grade_min":5,"grade_max":6,"difficulty":2,"tags":["english","现在进行时"],"subject":"english","stem":"She ____ a book now.","stem_image":null,"options":[{"label":"A","text":"reads"},{"label":"B","text":"is reading"},{"label":"C","text":"read"},{"label":"D","text":"reading"}],"answer":"B","explanation":"now表示现在此刻，用现在进行时is reading。","hint":"now提示现在进行时。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5352","module":"intellect","type":"question","subtype":"choice","grade_min":5,"grade_max":6,"difficulty":3,"tags":["english","现在进行时"],"subject":"english","stem":"\"swim\"的现在分词形式是？","stem_image":null,"options":[{"label":"A","text":"swiming"},{"label":"B","text":"swimming"},{"label":"C","text":"swims"},{"label":"D","text":"swimmed"}],"answer":"B","explanation":"swim以辅元辅结尾，双写末尾字母m再加ing→swimming。","hint":"辅元辅结尾要双写。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5353","module":"intellect","type":"question","subtype":"fill_blank","grade_min":5,"grade_max":6,"difficulty":2,"tags":["english","现在进行时"],"subject":"english","stem":"They ____ (watch) TV at the moment.","stem_image":null,"options":null,"answer":"are watching","explanation":"at the moment表示此刻，用现在进行时。主语They+are+watching。","hint":"at the moment提示进行时。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5354","module":"intellect","type":"question","subtype":"fill_blank","grade_min":5,"grade_max":6,"difficulty":3,"tags":["english","现在进行时"],"subject":"english","stem":"He ____ (have) lunch right now.","stem_image":null,"options":null,"answer":"is having","explanation":"right now表示此刻，用现在进行时。have→having（去e加ing）。","hint":"have去e加ing。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5355","module":"intellect","type":"question","subtype":"true_false","grade_min":5,"grade_max":6,"difficulty":2,"tags":["english","现在进行时"],"subject":"english","stem":"现在进行时的结构是\"be + 动词ing\"。","stem_image":null,"options":null,"answer":true,"explanation":"现在进行时=am/is/are + 动词现在分词(ing)。","hint":"be动词+现在分词。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5356","module":"intellect","type":"question","subtype":"choice","grade_min":5,"grade_max":6,"difficulty":3,"tags":["english","现在进行时"],"subject":"english","stem":"____ she ____ her homework now?","stem_image":null,"options":[{"label":"A","text":"Does, do"},{"label":"B","text":"Is, doing"},{"label":"C","text":"Does, doing"},{"label":"D","text":"Is, do"}],"answer":"B","explanation":"现在进行时疑问句：Is she doing her homework now? Be动词提前。","hint":"进行时疑问句把be提前。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5357","module":"intellect","type":"question","subtype":"choice","grade_min":5,"grade_max":6,"difficulty":2,"tags":["english","可数不可数名词"],"subject":"english","stem":"下列哪个是不可数名词？","stem_image":null,"options":[{"label":"A","text":"apple"},{"label":"B","text":"water"},{"label":"C","text":"egg"},{"label":"D","text":"book"}],"answer":"B","explanation":"water（水）是不可数名词，不能直接加s。apple、egg、book是可数名词。","hint":"液体通常是不可数的。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5358","module":"intellect","type":"question","subtype":"choice","grade_min":5,"grade_max":6,"difficulty":2,"tags":["english","可数不可数名词"],"subject":"english","stem":"I'd like ____ milk, please.","stem_image":null,"options":[{"label":"A","text":"a"},{"label":"B","text":"two"},{"label":"C","text":"some"},{"label":"D","text":"many"}],"answer":"C","explanation":"milk不可数，不能用a或数字。用some表示一些。many用于可数名词。","hint":"不可数名词前用some。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5359","module":"intellect","type":"question","subtype":"choice","grade_min":5,"grade_max":6,"difficulty":3,"tags":["english","可数不可数名词"],"subject":"english","stem":"There ____ much rice in the bowl.","stem_image":null,"options":[{"label":"A","text":"are"},{"label":"B","text":"is"},{"label":"C","text":"have"},{"label":"D","text":"has"}],"answer":"B","explanation":"rice是不可数名词，用is。much修饰不可数名词。","hint":"不可数名词用is。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5360","module":"intellect","type":"question","subtype":"fill_blank","grade_min":5,"grade_max":6,"difficulty":2,"tags":["english","可数不可数名词"],"subject":"english","stem":"不可数名词前面用much，可数名词复数前面用____。","stem_image":null,"options":null,"answer":"many","explanation":"much用于不可数名词，many用于可数名词复数。","hint":"m开头，和much对应。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5361","module":"intellect","type":"question","subtype":"fill_blank","grade_min":5,"grade_max":6,"difficulty":3,"tags":["english","可数不可数名词"],"subject":"english","stem":"I need two ____ (glass) of water.","stem_image":null,"options":null,"answer":"glasses","explanation":"water不可数，要用量词glasses来计数。two glasses of water=两杯水。","hint":"量词glass要变复数。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5362","module":"intellect","type":"question","subtype":"true_false","grade_min":5,"grade_max":6,"difficulty":2,"tags":["english","可数不可数名词"],"subject":"english","stem":"\"bread\"（面包）是不可数名词。","stem_image":null,"options":null,"answer":true,"explanation":"bread是不可数名词。要说\"一片面包\"用a piece of bread。","hint":"面包能数一个两个吗？","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5363","module":"intellect","type":"question","subtype":"choice","grade_min":5,"grade_max":6,"difficulty":3,"tags":["english","可数不可数名词"],"subject":"english","stem":"How ____ money do you have?","stem_image":null,"options":[{"label":"A","text":"many"},{"label":"B","text":"much"},{"label":"C","text":"some"},{"label":"D","text":"any"}],"answer":"B","explanation":"money是不可数名词，用how much提问数量。","hint":"money是可数还是不可数？","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5364","module":"intellect","type":"question","subtype":"choice","grade_min":5,"grade_max":6,"difficulty":2,"tags":["english","特殊疑问句"],"subject":"english","stem":"____ is your teacher? — Miss Li.","stem_image":null,"options":[{"label":"A","text":"What"},{"label":"B","text":"Who"},{"label":"C","text":"Where"},{"label":"D","text":"When"}],"answer":"B","explanation":"问人用Who。Who is your teacher?=你的老师是谁？","hint":"回答是人名，用什么问。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5365","module":"intellect","type":"question","subtype":"choice","grade_min":5,"grade_max":6,"difficulty":2,"tags":["english","特殊疑问句"],"subject":"english","stem":"____ do you go to school? — By bus.","stem_image":null,"options":[{"label":"A","text":"What"},{"label":"B","text":"Where"},{"label":"C","text":"How"},{"label":"D","text":"Why"}],"answer":"C","explanation":"回答方式（by bus），用How提问。How do you go to school?=你怎么去学校？","hint":"问方式用什么疑问词？","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5366","module":"intellect","type":"question","subtype":"choice","grade_min":5,"grade_max":6,"difficulty":3,"tags":["english","特殊疑问句"],"subject":"english","stem":"____ is your birthday? — It's on May 5th.","stem_image":null,"options":[{"label":"A","text":"What"},{"label":"B","text":"When"},{"label":"C","text":"Where"},{"label":"D","text":"How"}],"answer":"B","explanation":"回答时间（May 5th），用When提问。","hint":"问时间用什么词？","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5367","module":"intellect","type":"question","subtype":"fill_blank","grade_min":5,"grade_max":6,"difficulty":2,"tags":["english","特殊疑问句"],"subject":"english","stem":"____ are you from? — I'm from China.（你来自哪里？）","stem_image":null,"options":null,"answer":"Where","explanation":"问地点/地方用Where。Where are you from?=你来自哪里？","hint":"问地方用W开头的词。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5368","module":"intellect","type":"question","subtype":"fill_blank","grade_min":5,"grade_max":6,"difficulty":3,"tags":["english","特殊疑问句"],"subject":"english","stem":"____ ____ students are there in your class?（你班有多少学生？）","stem_image":null,"options":null,"answer":"How many","explanation":"问可数名词的数量用How many。","hint":"问数量用两个词。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5369","module":"intellect","type":"question","subtype":"true_false","grade_min":5,"grade_max":6,"difficulty":2,"tags":["english","特殊疑问句"],"subject":"english","stem":"特殊疑问句不能用Yes或No回答。","stem_image":null,"options":null,"answer":true,"explanation":"特殊疑问句需要具体回答，不能用Yes/No。一般疑问句才用Yes/No回答。","hint":"What、Where等提问需要具体答案。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5370","module":"intellect","type":"question","subtype":"choice","grade_min":5,"grade_max":6,"difficulty":3,"tags":["english","特殊疑问句"],"subject":"english","stem":"____ don't you like winter? — Because it's too cold.","stem_image":null,"options":[{"label":"A","text":"What"},{"label":"B","text":"When"},{"label":"C","text":"Why"},{"label":"D","text":"How"}],"answer":"C","explanation":"回答Because...（因为...），用Why提问原因。","hint":"因为...所以问为什么。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5371","module":"intellect","type":"question","subtype":"choice","grade_min":5,"grade_max":6,"difficulty":2,"tags":["english","阅读判断"],"subject":"english","stem":"读短文：\"Tom is 11 years old. He likes playing football. He plays football every Saturday.\" 判断：Tom plays football every day.","stem_image":null,"options":[{"label":"A","text":"True（正确）"},{"label":"B","text":"False（错误）"},{"label":"C","text":"未提及"},{"label":"D","text":"不确定"}],"answer":"B","explanation":"文中说every Saturday（每周六），不是every day（每天）。","hint":"注意区分every Saturday和every day。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5372","module":"intellect","type":"question","subtype":"choice","grade_min":5,"grade_max":6,"difficulty":3,"tags":["english","阅读判断"],"subject":"english","stem":"读短文：\"Amy has a cat. The cat is white. It likes fish. Amy feeds it every day.\" 判断：Amy's cat is black.","stem_image":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"},{"label":"C","text":"未提及"},{"label":"D","text":"不确定"}],"answer":"B","explanation":"文中说The cat is white（白色），不是black（黑色）。","hint":"注意颜色描述。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5373","module":"intellect","type":"question","subtype":"choice","grade_min":5,"grade_max":6,"difficulty":3,"tags":["english","阅读判断"],"subject":"english","stem":"读短文：\"There are four seasons in a year. Spring is warm. Summer is hot. Autumn is cool. Winter is cold.\" 判断：The hottest season is summer.","stem_image":null,"options":[{"label":"A","text":"True"},{"label":"B","text":"False"},{"label":"C","text":"未提及"},{"label":"D","text":"不确定"}],"answer":"A","explanation":"文中说Summer is hot，是四季中描述为hot的季节。","hint":"哪个季节是hot？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5374","module":"intellect","type":"question","subtype":"fill_blank","grade_min":5,"grade_max":6,"difficulty":2,"tags":["english","阅读判断"],"subject":"english","stem":"读短文：\"My name is Lily. I am 10. I like drawing.\" Lily's hobby is ____.","stem_image":null,"options":null,"answer":"drawing","explanation":"文中说I like drawing，所以Lily的爱好是drawing（画画）。","hint":"like后面的词就是爱好。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5375","module":"intellect","type":"question","subtype":"fill_blank","grade_min":5,"grade_max":6,"difficulty":3,"tags":["english","阅读判断"],"subject":"english","stem":"读短文：\"Bob gets up at 7:00. He has breakfast at 7:30. He goes to school at 8:00.\" Bob has breakfast at ____.","stem_image":null,"options":null,"answer":"7:30","explanation":"文中明确说He has breakfast at 7:30。","hint":"直接从文中找答案。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5376","module":"intellect","type":"question","subtype":"true_false","grade_min":5,"grade_max":6,"difficulty":2,"tags":["english","阅读判断"],"subject":"english","stem":"读短文：\"Mike has two brothers. They are John and David.\" Mike有三个兄弟。","stem_image":null,"options":null,"answer":false,"explanation":"Mike has two brothers（两个兄弟），不是三个。","hint":"注意数字two。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5377","module":"intellect","type":"question","subtype":"choice","grade_min":5,"grade_max":6,"difficulty":3,"tags":["english","阅读判断"],"subject":"english","stem":"读短文：\"We have English, math and Chinese on Monday. On Tuesday, we have music, PE and science.\" How many subjects do they have on Monday?","stem_image":null,"options":[{"label":"A","text":"Two"},{"label":"B","text":"Three"},{"label":"C","text":"Four"},{"label":"D","text":"Five"}],"answer":"B","explanation":"周一有English, math and Chinese三门课。","hint":"数一数周一有几门课。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5378","module":"intellect","type":"question","subtype":"choice","grade_min":5,"grade_max":6,"difficulty":2,"tags":["english","连词成句"],"subject":"english","stem":"将词语连成句子：is, this, pen, my","stem_image":null,"options":[{"label":"A","text":"This is my pen."},{"label":"B","text":"My pen is this."},{"label":"C","text":"Is this my pen."},{"label":"D","text":"Pen my this is."}],"answer":"A","explanation":"正确语序：This is my pen.（这是我的钢笔。）","hint":"This is...是常用句式。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5379","module":"intellect","type":"question","subtype":"choice","grade_min":5,"grade_max":6,"difficulty":3,"tags":["english","连词成句"],"subject":"english","stem":"连词成句：can, you, speak, English (?)","stem_image":null,"options":[{"label":"A","text":"You can speak English?"},{"label":"B","text":"Can you speak English?"},{"label":"C","text":"English can you speak?"},{"label":"D","text":"Speak you can English?"}],"answer":"B","explanation":"情态动词can提前构成疑问句：Can you speak English?","hint":"疑问句中can放最前面。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5380","module":"intellect","type":"question","subtype":"choice","grade_min":5,"grade_max":6,"difficulty":3,"tags":["english","连词成句"],"subject":"english","stem":"连词成句：like, I, playing, basketball (.)","stem_image":null,"options":[{"label":"A","text":"I playing like basketball."},{"label":"B","text":"I like basketball playing."},{"label":"C","text":"I like playing basketball."},{"label":"D","text":"Playing I like basketball."}],"answer":"C","explanation":"I like playing basketball.（我喜欢打篮球。）like+动词ing。","hint":"like后面跟动词ing形式。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5381","module":"intellect","type":"question","subtype":"fill_blank","grade_min":5,"grade_max":6,"difficulty":2,"tags":["english","连词成句"],"subject":"english","stem":"连词成句：are, there, flowers, some, in, garden, the (.)→____","stem_image":null,"options":null,"answer":"There are some flowers in the garden.","explanation":"There be句型：There are some flowers in the garden.（花园里有一些花。）","hint":"There are...in...","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5382","module":"intellect","type":"question","subtype":"fill_blank","grade_min":5,"grade_max":6,"difficulty":3,"tags":["english","连词成句"],"subject":"english","stem":"连词成句：does, what, she, do, on, Sundays (?)→____","stem_image":null,"options":null,"answer":"What does she do on Sundays?","explanation":"特殊疑问句：What does she do on Sundays?（她周日做什么？）","hint":"疑问词+助动词+主语+动词。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5383","module":"intellect","type":"question","subtype":"true_false","grade_min":5,"grade_max":6,"difficulty":2,"tags":["english","连词成句"],"subject":"english","stem":"\"am, I, student, a\"连成句子是\"I am a student.\"","stem_image":null,"options":null,"answer":true,"explanation":"正确语序：I am a student.（我是一名学生。）","hint":"主语+be动词+表语。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5384","module":"intellect","type":"question","subtype":"choice","grade_min":5,"grade_max":6,"difficulty":3,"tags":["english","连词成句"],"subject":"english","stem":"连词成句：usually, we, at, lunch, have, twelve (.)","stem_image":null,"options":[{"label":"A","text":"We usually have lunch at twelve."},{"label":"B","text":"Usually we at twelve have lunch."},{"label":"C","text":"We have usually lunch at twelve."},{"label":"D","text":"At twelve usually we have lunch."}],"answer":"A","explanation":"We usually have lunch at twelve.（我们通常12点吃午饭。）频率副词usually放在行为动词前。","hint":"usually放在动词前面。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"}
