    ],
    "subject": "english",
    "stem": "This book is ____ than that one. (interesting)",
    "stem_image": null,
    "options": [
      {
        "label": "A",
        "text": "interestinger"
      },
      {
        "label": "B",
        "text": "more interesting"
      },
      {
        "label": "C",
        "text": "most interesting"
      },
      {
        "label": "D",
        "text": "more interestinger"
      }
    ],
    "answer": "B",
    "explanation": "interesting 是多音节词，比较级要在前面加 more，变成 more interesting。多音节形容词（通常三个音节以上）的比较级用 “more + 原级”。",
    "hint": "多音节的形容词（如 interesting, beautiful）变比较级时，不是加 -er，而是在前面加什么？",
    "time_limit_seconds": 25,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_1604",
    "module": "intellect",
    "type": "question",
    "subtype": "choice",
    "grade_min": 5,
    "grade_max": 6,
