      "情态动词"
    ],
    "subject": "english",
    "stem": "You ____ finish your homework before you play. (你必须先完成作业再玩。)",
    "stem_image": null,
    "options": [
      {
        "label": "A",
        "text": "can"
      },
      {
        "label": "B",
        "text": "must"
      },
      {
        "label": "C",
        "text": "may"
      },
      {
        "label": "D",
        "text": "would"
      }
    ],
    "answer": "B",
    "explanation": "must 表示“必须”，语气最强，表示义务或必要性。can 表示“能够”，may 表示“可以/也许”，would 表示“会/愿意”。这里强调“必须”完成作业，所以用 must。",
    "hint": "句子的意思是“必须”先做完作业，哪个情态动词表示“必须”？",
    "time_limit_seconds": 25,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  },
  {
    "id": "intellect_q_1605",
    "module": "intellect",
