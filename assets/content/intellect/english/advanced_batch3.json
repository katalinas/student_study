[
  {"id":"intellect_q_5385","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":3,"tags":["english","情态动词must/may/might"],"subject":"english","stem":"You ____ be tired after working all day.（你工作了一整天一定很累。）","stem_image":null,"options":[{"label":"A","text":"can"},{"label":"B","text":"must"},{"label":"C","text":"may"},{"label":"D","text":"might"}],"answer":"B","explanation":"must表示很有把握的推测\"一定\"。工作了一整天，一定很累。","hint":"\"一定\"用哪个情态动词？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5386","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":4,"tags":["english","情态动词must/may/might"],"subject":"english","stem":"He ____ be at home. I'm not sure.（他可能在家，我不确定。）","stem_image":null,"options":[{"label":"A","text":"must"},{"label":"B","text":"can't"},{"label":"C","text":"may"},{"label":"D","text":"should"}],"answer":"C","explanation":"may表示不太确定的推测\"可能\"，和\"I'm not sure\"一致。","hint":"不确定时用什么？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5387","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":4,"tags":["english","情态动词must/may/might"],"subject":"english","stem":"It ____ rain tomorrow. There are some dark clouds.","stem_image":null,"options":[{"label":"A","text":"must"},{"label":"B","text":"might"},{"label":"C","text":"can't"},{"label":"D","text":"won't"}],"answer":"B","explanation":"有乌云但不完全确定明天会不会下雨，用might表示\"也许、可能\"。","hint":"有迹象但不完全确定。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5388","module":"intellect","type":"question","subtype":"fill_blank","grade_min":7,"grade_max":9,"difficulty":3,"tags":["english","情态动词must/may/might"],"subject":"english","stem":"You ____ finish your homework before watching TV.（你必须先完成作业才能看电视。）","stem_image":null,"options":null,"answer":"must","explanation":"must表示\"必须\"，强调义务。","hint":"\"必须\"用哪个词？","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5389","module":"intellect","type":"question","subtype":"fill_blank","grade_min":7,"grade_max":9,"difficulty":4,"tags":["english","情态动词must/may/might"],"subject":"english","stem":"The light is off. He ____ not be at home.（灯灭着，他可能不在家。）","stem_image":null,"options":null,"answer":"may","explanation":"may not表示可能不，是不太确定的否定推测。","hint":"不完全确定的否定推测。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5390","module":"intellect","type":"question","subtype":"true_false","grade_min":7,"grade_max":9,"difficulty":3,"tags":["english","情态动词must/may/might"],"subject":"english","stem":"must表示推测时的语气比may/might更强。","stem_image":null,"options":null,"answer":true,"explanation":"推测的把握程度：must(一定) > may(可能) > might(也许)。must最有把握。","hint":"比较三者的肯定程度。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5391","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":5,"tags":["english","情态动词must/may/might"],"subject":"english","stem":"— Must I clean the room now?\n— No, you ____.","stem_image":null,"options":[{"label":"A","text":"mustn't"},{"label":"B","text":"can't"},{"label":"C","text":"needn't"},{"label":"D","text":"may not"}],"answer":"C","explanation":"Must I...?的否定回答用No, you needn't.或No, you don't have to.（不需要）。mustn't表禁止。","hint":"Must的否定回答不是mustn't。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5392","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":3,"tags":["english","直接间接引语"],"subject":"english","stem":"Tom said, \"I am hungry.\" 变间接引语→Tom said that he ____ hungry.","stem_image":null,"options":[{"label":"A","text":"is"},{"label":"B","text":"was"},{"label":"C","text":"am"},{"label":"D","text":"will be"}],"answer":"B","explanation":"直接引语变间接引语：am→was（时态后移），I→he（人称变化）。","hint":"时态往后退一步。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5393","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":4,"tags":["english","直接间接引语"],"subject":"english","stem":"She said, \"I will come tomorrow.\" 变间接引语→She said that she ____ come ____.","stem_image":null,"options":[{"label":"A","text":"would, the next day"},{"label":"B","text":"will, tomorrow"},{"label":"C","text":"would, tomorrow"},{"label":"D","text":"will, the next day"}],"answer":"A","explanation":"will→would，tomorrow→the next day。时态和时间状语都要变化。","hint":"will变would，tomorrow变the next day。","time_limit_seconds":25,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5394","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":4,"tags":["english","直接间接引语"],"subject":"english","stem":"He asked me, \"Do you like music?\" 变间接引语→He asked me ____ I liked music.","stem_image":null,"options":[{"label":"A","text":"that"},{"label":"B","text":"if/whether"},{"label":"C","text":"what"},{"label":"D","text":"which"}],"answer":"B","explanation":"一般疑问句变间接引语用if或whether引导。","hint":"一般疑问句变间接引语用什么词连接？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5395","module":"intellect","type":"question","subtype":"fill_blank","grade_min":7,"grade_max":9,"difficulty":3,"tags":["english","直接间接引语"],"subject":"english","stem":"\"I like apples,\" he said. → He said that he ____ apples.","stem_image":null,"options":null,"answer":"liked","explanation":"like→liked（一般现在时变一般过去时）。","hint":"时态后移。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5396","module":"intellect","type":"question","subtype":"fill_blank","grade_min":7,"grade_max":9,"difficulty":5,"tags":["english","直接间接引语"],"subject":"english","stem":"She asked, \"Where do you live?\" → She asked me where I ____.","stem_image":null,"options":null,"answer":"lived","explanation":"特殊疑问句变间接引语保留疑问词，语序变陈述序，时态后移。live→lived。","hint":"注意语序和时态变化。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5397","module":"intellect","type":"question","subtype":"true_false","grade_min":7,"grade_max":9,"difficulty":3,"tags":["english","直接间接引语"],"subject":"english","stem":"直接引语变间接引语时，如果主句是过去时，从句中的时态一般要往后推一个时态。","stem_image":null,"options":null,"answer":true,"explanation":"这是间接引语时态变化的基本规则：一般现在→一般过去，一般过去→过去完成，will→would等。","hint":"这叫时态后移。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5398","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":5,"tags":["english","直接间接引语"],"subject":"english","stem":"\"The earth goes around the sun,\" the teacher said. → The teacher said that the earth ____ around the sun.","stem_image":null,"options":[{"label":"A","text":"went"},{"label":"B","text":"goes"},{"label":"C","text":"is going"},{"label":"D","text":"will go"}],"answer":"B","explanation":"客观真理和自然规律在间接引语中不变时态，仍用一般现在时goes。","hint":"地球绕太阳转是客观事实。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5399","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":3,"tags":["english","主谓一致"],"subject":"english","stem":"Everyone ____ here now.","stem_image":null,"options":[{"label":"A","text":"are"},{"label":"B","text":"is"},{"label":"C","text":"were"},{"label":"D","text":"am"}],"answer":"B","explanation":"everyone是不定代词，作主语时谓语用单数is。","hint":"everyone看作单数。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5400","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":4,"tags":["english","主谓一致"],"subject":"english","stem":"Neither Tom nor his friends ____ going to the party.","stem_image":null,"options":[{"label":"A","text":"is"},{"label":"B","text":"are"},{"label":"C","text":"was"},{"label":"D","text":"has"}],"answer":"B","explanation":"neither...nor...连接主语时，谓语动词与最近的主语(his friends复数)一致，用are。","hint":"就近原则：看离谓语最近的主语。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5401","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":4,"tags":["english","主谓一致"],"subject":"english","stem":"The number of students in our school ____ over 2000.","stem_image":null,"options":[{"label":"A","text":"are"},{"label":"B","text":"is"},{"label":"C","text":"were"},{"label":"D","text":"have"}],"answer":"B","explanation":"the number of表示\"...的数量\"，作主语时谓语用单数is。（a number of才用复数）","hint":"the number of=数量，用单数。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5402","module":"intellect","type":"question","subtype":"fill_blank","grade_min":7,"grade_max":9,"difficulty":3,"tags":["english","主谓一致"],"subject":"english","stem":"Math ____ (be) my favorite subject.","stem_image":null,"options":null,"answer":"is","explanation":"Math（数学）是学科名称，虽以s结尾但是单数概念，用is。","hint":"学科名词是单数。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5403","module":"intellect","type":"question","subtype":"fill_blank","grade_min":7,"grade_max":9,"difficulty":4,"tags":["english","主谓一致"],"subject":"english","stem":"Two hours ____ (be) enough for the test.","stem_image":null,"options":null,"answer":"is","explanation":"时间、距离、金额等表示整体概念时，谓语用单数。Two hours看作一个整体时间段。","hint":"时间段看作整体。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5404","module":"intellect","type":"question","subtype":"true_false","grade_min":7,"grade_max":9,"difficulty":3,"tags":["english","主谓一致"],"subject":"english","stem":"\"a number of+复数名词\"作主语时，谓语用复数。","stem_image":null,"options":null,"answer":true,"explanation":"a number of=许多，后接复数名词和复数谓语。A number of students are absent.","hint":"a number of=许多。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5405","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":5,"tags":["english","主谓一致"],"subject":"english","stem":"Not only he but also I ____ interested in English.","stem_image":null,"options":[{"label":"A","text":"is"},{"label":"B","text":"am"},{"label":"C","text":"are"},{"label":"D","text":"was"}],"answer":"B","explanation":"not only...but also...遵循就近原则，谓语与I一致，用am。","hint":"就近原则，看离谓语最近的主语。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5406","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":4,"tags":["english","完形填空"],"subject":"english","stem":"I have a good friend. ____ name is Jack. He is kind and helpful.","stem_image":null,"options":[{"label":"A","text":"His"},{"label":"B","text":"Her"},{"label":"C","text":"My"},{"label":"D","text":"Its"}],"answer":"A","explanation":"后面说He，所以是男性，用His（他的）。","hint":"注意后文的He。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5407","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":4,"tags":["english","完形填空"],"subject":"english","stem":"She was very ____ because she passed the exam.","stem_image":null,"options":[{"label":"A","text":"sad"},{"label":"B","text":"angry"},{"label":"C","text":"happy"},{"label":"D","text":"tired"}],"answer":"C","explanation":"通过了考试（passed the exam），所以很高兴（happy）。","hint":"通过考试是好事还是坏事？","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5408","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":5,"tags":["english","完形填空"],"subject":"english","stem":"We should protect the environment. ____, we can plant more trees.","stem_image":null,"options":[{"label":"A","text":"However"},{"label":"B","text":"For example"},{"label":"C","text":"But"},{"label":"D","text":"Although"}],"answer":"B","explanation":"后面举了种树的例子来说明如何保护环境，用For example（例如）。","hint":"后面是一个具体的例子。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5409","module":"intellect","type":"question","subtype":"fill_blank","grade_min":7,"grade_max":9,"difficulty":3,"tags":["english","完形填空"],"subject":"english","stem":"Tom is taller ____ his brother.（Tom比他弟弟高。）","stem_image":null,"options":null,"answer":"than","explanation":"比较级+than表示\"比...更...\"。taller than=比...更高。","hint":"比较级后面用什么词？","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5410","module":"intellect","type":"question","subtype":"fill_blank","grade_min":7,"grade_max":9,"difficulty":4,"tags":["english","完形填空"],"subject":"english","stem":"The movie was so ____ that everyone fell asleep.（电影太无聊了，大家都睡着了。）","stem_image":null,"options":null,"answer":"boring","explanation":"电影让人无聊用boring（令人无聊的），bored指人感到无聊。","hint":"修饰事物用-ing结尾的形容词。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5411","module":"intellect","type":"question","subtype":"true_false","grade_min":7,"grade_max":9,"difficulty":4,"tags":["english","完形填空"],"subject":"english","stem":"做完形填空时，应该先通读全文了解大意，再逐空选择。","stem_image":null,"options":null,"answer":true,"explanation":"完形填空的正确方法：先通读全文了解大意和上下文关系，再根据语境和语法逐空选择。","hint":"整体理解比逐词翻译更重要。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5412","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":5,"tags":["english","完形填空"],"subject":"english","stem":"He worked hard ____ he could pass the exam.","stem_image":null,"options":[{"label":"A","text":"so that"},{"label":"B","text":"even though"},{"label":"C","text":"as if"},{"label":"D","text":"unless"}],"answer":"A","explanation":"so that表示\"以便\"，引导目的状语从句。他努力学习以便能通过考试。","hint":"表示目的。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5413","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":4,"tags":["english","短文首字母填空"],"subject":"english","stem":"Read: \"The sun r____ in the east and sets in the west.\" r____处应填？","stem_image":null,"options":[{"label":"A","text":"runs"},{"label":"B","text":"rises"},{"label":"C","text":"rains"},{"label":"D","text":"reads"}],"answer":"B","explanation":"太阳从东方升起：The sun rises in the east. rise=升起。","hint":"太阳从东边怎么了？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5414","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":4,"tags":["english","短文首字母填空"],"subject":"english","stem":"\"Water is very i____ to all living things.\" i____处应填？","stem_image":null,"options":[{"label":"A","text":"interesting"},{"label":"B","text":"important"},{"label":"C","text":"impossible"},{"label":"D","text":"immediate"}],"answer":"B","explanation":"水对所有生物都很重要(important)。","hint":"水对生命是什么的？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5415","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":5,"tags":["english","短文首字母填空"],"subject":"english","stem":"\"He was so e____ that he jumped up and down.\" e____处应填？","stem_image":null,"options":[{"label":"A","text":"excited"},{"label":"B","text":"embarrassed"},{"label":"C","text":"exhausted"},{"label":"D","text":"educated"}],"answer":"A","explanation":"高兴得跳起来，说明非常激动(excited)。","hint":"什么情绪会让人跳起来？","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5416","module":"intellect","type":"question","subtype":"fill_blank","grade_min":7,"grade_max":9,"difficulty":3,"tags":["english","短文首字母填空"],"subject":"english","stem":"Spring is the best s____ for planting trees.","stem_image":null,"options":null,"answer":"season","explanation":"spring is the best season（季节）for planting trees. 春天是植树的最佳季节。","hint":"春天是最好的什么？","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5417","module":"intellect","type":"question","subtype":"fill_blank","grade_min":7,"grade_max":9,"difficulty":5,"tags":["english","短文首字母填空"],"subject":"english","stem":"We should be p____ in public places and not make noise.","stem_image":null,"options":null,"answer":"polite","explanation":"在公共场所应该有礼貌(polite)，不制造噪音。","hint":"p开头，和礼貌有关。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5418","module":"intellect","type":"question","subtype":"true_false","grade_min":7,"grade_max":9,"difficulty":4,"tags":["english","短文首字母填空"],"subject":"english","stem":"做首字母填空时，需要根据上下文语境和语法来判断所填单词。","stem_image":null,"options":null,"answer":true,"explanation":"首字母填空需要综合考虑上下文意思和语法要求（如时态、单复数等）来填写正确的单词。","hint":"语境和语法都要考虑。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5419","module":"intellect","type":"question","subtype":"choice","grade_min":7,"grade_max":9,"difficulty":5,"tags":["english","短文首字母填空"],"subject":"english","stem":"\"Knowledge is p____. The more you learn, the stronger you become.\" p____处应填？","stem_image":null,"options":[{"label":"A","text":"popular"},{"label":"B","text":"power"},{"label":"C","text":"peaceful"},{"label":"D","text":"perfect"}],"answer":"B","explanation":"Knowledge is power.（知识就是力量。）这是弗朗西斯·培根的名言。","hint":"这是一句名言。","time_limit_seconds":20,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"}
