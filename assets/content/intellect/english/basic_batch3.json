  {"id":"intellect_q_5321","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":2,"tags":["english","颜色形状"],"subject":"english","stem":"Bananas are ____.","stem_image":null,"options":[{"label":"A","text":"red"},{"label":"B","text":"blue"},{"label":"C","text":"yellow"},{"label":"D","text":"green"}],"answer":"C","explanation":"香蕉是黄色的，yellow意为黄色。","hint":"想想香蕉的颜色。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5322","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":1,"tags":["english","课堂用语"],"subject":"english","stem":"老师说\"Stand up, please.\"，意思是？","stem_image":null,"options":[{"label":"A","text":"请坐下"},{"label":"B","text":"请站起来"},{"label":"C","text":"请打开书"},{"label":"D","text":"请举手"}],"answer":"B","explanation":"Stand up意为站起来。","hint":"stand=站。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5323","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":1,"tags":["english","课堂用语"],"subject":"english","stem":"\"Open your books.\"是什么意思？","stem_image":null,"options":[{"label":"A","text":"合上你的书"},{"label":"B","text":"打开你的书"},{"label":"C","text":"拿出你的书"},{"label":"D","text":"读你的书"}],"answer":"B","explanation":"open意为打开，Open your books=打开你的书。","hint":"open=打开。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5324","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":2,"tags":["english","课堂用语"],"subject":"english","stem":"如果你没听清老师说的话，应该说？","stem_image":null,"options":[{"label":"A","text":"Thank you."},{"label":"B","text":"Sorry, I don't know."},{"label":"C","text":"Pardon? / Could you say that again?"},{"label":"D","text":"Goodbye."}],"answer":"C","explanation":"没听清时说Pardon?或Could you say that again?请老师重复一遍。","hint":"让对方再说一遍。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
