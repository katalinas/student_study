  {"id":"intellect_q_5328","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":2,"tags":["english","课堂用语"],"subject":"english","stem":"下课时老师说\"Class is ____.\"","stem_image":null,"options":[{"label":"A","text":"begin"},{"label":"B","text":"over"},{"label":"C","text":"open"},{"label":"D","text":"start"}],"answer":"B","explanation":"Class is over.=下课了。over意为结束。","hint":"over=结束。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5329","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":1,"tags":["english","物主代词"],"subject":"english","stem":"\"my\"是什么意思？","stem_image":null,"options":[{"label":"A","text":"我"},{"label":"B","text":"我的"},{"label":"C","text":"我们"},{"label":"D","text":"他的"}],"answer":"B","explanation":"my是形容词性物主代词，意为\"我的\"。I是\"我\"。","hint":"my book=我的书。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5330","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":2,"tags":["english","物主代词"],"subject":"english","stem":"This is ____ pen.（这是他的钢笔。）","stem_image":null,"options":[{"label":"A","text":"he"},{"label":"B","text":"him"},{"label":"C","text":"his"},{"label":"D","text":"her"}],"answer":"C","explanation":"his是\"他的\"，形容词性物主代词，放在名词前面修饰名词。","hint":"\"他的\"用哪个词？","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5331","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":2,"tags":["english","物主代词"],"subject":"english","stem":"The cat is washing ____ face.（猫在洗它的脸。）","stem_image":null,"options":[{"label":"A","text":"it"},{"label":"B","text":"its"},{"label":"C","text":"it's"},{"label":"D","text":"his"}],"answer":"B","explanation":"its是\"它的\"（物主代词）。it's=it is。注意区分。","hint":"\"它的\"没有撇号。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5332","module":"intellect","type":"question","subtype":"fill_blank","grade_min":3,"grade_max":4,"difficulty":1,"tags":["english","物主代词"],"subject":"english","stem":"I → my, you → ____","stem_image":null,"options":null,"answer":"your","explanation":"you的物主代词是your（你的/你们的）。","hint":"you的所有格。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5333","module":"intellect","type":"question","subtype":"fill_blank","grade_min":3,"grade_max":4,"difficulty":2,"tags":["english","物主代词"],"subject":"english","stem":"she → ____（她的）","stem_image":null,"options":null,"answer":"her","explanation":"she的物主代词是her（她的）。","hint":"she→her。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5334","module":"intellect","type":"question","subtype":"true_false","grade_min":3,"grade_max":4,"difficulty":1,"tags":["english","物主代词"],"subject":"english","stem":"\"our\"是\"我们的\"的意思。","stem_image":null,"options":null,"answer":true,"explanation":"our是we的物主代词，意为\"我们的\"。","hint":"we→our。","time_limit_seconds":10,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5335","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":2,"tags":["english","物主代词"],"subject":"english","stem":"This book is ____. （这本书是我的。）","stem_image":null,"options":[{"label":"A","text":"my"},{"label":"B","text":"mine"},{"label":"C","text":"me"},{"label":"D","text":"I"}],"answer":"B","explanation":"mine是名词性物主代词\"我的\"，可以单独使用。my后面要跟名词（如my book）。","hint":"不跟名词，单独表示\"我的\"。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5336","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":1,"tags":["english","方位词"],"subject":"english","stem":"\"in\"表示什么方位？","stem_image":null,"options":[{"label":"A","text":"在...上面"},{"label":"B","text":"在...里面"},{"label":"C","text":"在...下面"},{"label":"D","text":"在...旁边"}],"answer":"B","explanation":"in意为在...里面。如in the box=在盒子里面。","hint":"想想\"in the bag\"。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5337","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":1,"tags":["english","方位词"],"subject":"english","stem":"The book is ____ the desk.（书在桌子上面。）","stem_image":null,"options":[{"label":"A","text":"under"},{"label":"B","text":"in"},{"label":"C","text":"on"},{"label":"D","text":"behind"}],"answer":"C","explanation":"on表示在...上面（接触表面）。on the desk=在桌子上。","hint":"在桌面上用什么介词？","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5338","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":2,"tags":["english","方位词"],"subject":"english","stem":"The cat is ____ the table.（猫在桌子下面。）","stem_image":null,"options":[{"label":"A","text":"on"},{"label":"B","text":"in"},{"label":"C","text":"under"},{"label":"D","text":"behind"}],"answer":"C","explanation":"under意为在...下面。under the table=在桌子下面。","hint":"下面用什么词？","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
