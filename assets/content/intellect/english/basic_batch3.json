  {"id":"intellect_q_5341","module":"intellect","type":"question","subtype":"true_false","grade_min":3,"grade_max":4,"difficulty":1,"tags":["english","方位词"],"subject":"english","stem":"\"between\"表示在两者之间。","stem_image":null,"options":null,"answer":true,"explanation":"between A and B意为在A和B之间。","hint":"between...and...是固定搭配。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5342","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":2,"tags":["english","方位词"],"subject":"english","stem":"The park is ____ front of the school.（公园在学校前面。）","stem_image":null,"options":[{"label":"A","text":"at"},{"label":"B","text":"on"},{"label":"C","text":"in"},{"label":"D","text":"to"}],"answer":"C","explanation":"in front of意为在...前面。是固定短语。","hint":"in front of是固定搭配。","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
  {"id":"intellect_q_5343","module":"intellect","type":"question","subtype":"choice","grade_min":3,"grade_max":4,"difficulty":1,"tags":["english","日常对话"],"subject":"english","stem":"别人说\"Thank you.\"，你应该回答？","stem_image":null,"options":[{"label":"A","text":"Sorry."},{"label":"B","text":"You're welcome."},{"label":"C","text":"Hello."},{"label":"D","text":"Goodbye."}],"answer":"B","explanation":"回答Thank you用You're welcome.（不客气。）","hint":"别人感谢你时怎么回应？","time_limit_seconds":15,"points":10,"version":1,"created_at":"2026-03-27","updated_at":"2026-03-27"},
