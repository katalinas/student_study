    "subject": "math",
    "stem": "方程 x² - 5x + 6 = 0 的两个根是？",
    "stem_image": null,
    "options": [
      {"label": "A", "text": "x = 2 和 x = 3"},
      {"label": "B", "text": "x = -2 和 x = -3"},
      {"label": "C", "text": "x = 1 和 x = 6"},
      {"label": "D", "text": "x = -1 和 x = 5"}
    ],
    "answer": "A",
    "explanation": "x² - 5x + 6 = (x-2)(x-3) = 0，所以x = 2或x = 3。",
    "hint": "尝试因式分解",
    "time_limit_seconds": 30,
    "points": 10,
