    "stem": "解方程组：2x + 3y = 12，x + y = 5，则y等于多少？",
    "stem_image": null,
    "options": [
      {"label": "A", "text": "1"},
      {"label": "B", "text": "2"},
      {"label": "C", "text": "3"},
      {"label": "D", "text": "4"}
    ],
    "answer": "B",
    "explanation": "由第二个方程x=5-y，代入第一个：2(5-y)+3y=12，10-2y+3y=12，y=2。",
    "hint": "用代入法，从第二个方程表示出x。",
    "time_limit_seconds": 30,
    "points": 10,
