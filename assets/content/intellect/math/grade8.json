    "options": [
      {"label": "A", "text": "8"},
      {"label": "B", "text": "10"},
      {"label": "C", "text": "12"},
      {"label": "D", "text": "√144"}
    ],
    "answer": "C",
    "explanation": "由勾股定理：另一条直角边=√(13²-5²)=√(169-25)=√144=12。注意D选项√144=12，但C是化简后的结果。5-12-13是常见勾股数。",
    "hint": "用勾股定理反求另一条直角边。",
    "time_limit_seconds": 30,
    "points": 10,
    "version": 1,
    "created_at": "2026-03-27",
