      {"id": "vinegar", "name": "白醋", "icon": "vinegar.png", "count": 1},
      {"id": "lemon_juice", "name": "柠檬汁", "icon": "lemon.png", "count": 1},
      {"id": "soap_water", "name": "肥皂水", "icon": "soap.png", "count": 1},
      {"id": "baking_soda_water", "name": "小苏打水", "icon": "soda.png", "count": 1},
