    "difficulty": 3,
    "tags": ["tech", "chemistry", "氧化", "生锈", "铁"],
    "title": "铁钉生锈观察",
    "category": "化学实验",
    "cover_image": null,
    "description": "设置对照实验，将铁钉分别放在干燥环境、纯水中和盐水中，观察一周内的变化，探究铁生锈需要哪些条件。",
    "learning_goals": [
      "了解铁生锈是铁与水和氧气共同作用的氧化反应",
      "学会设计对照实验来探究影响因素",
      "培养长期观察和记录实验数据的习惯"
    ],
    "components": [
      {"id": "iron_nail", "name": "普通铁钉", "icon": "nail.png", "count": 4},
      {"id": "test_tube", "name": "密封玻璃瓶", "icon": "tube.png", "count": 4},
      {"id": "water", "name": "清水", "icon": "water.png", "count": 1},
      {"id": "salt_water", "name": "盐水", "icon": "saltwater.png", "count": 1},
      {"id": "oil", "name": "食用油", "icon": "oil.png", "count": 1},
      {"id": "desiccant", "name": "干燥剂", "icon": "desiccant.png", "count": 1},
      {"id": "notebook", "name": "观察记录本", "icon": "notebook.png", "count": 1}
    ],
    "steps": [
      {
        "order": 1,
        "instruction": "准备4个密封玻璃瓶，分别标记为A、B、C、D。在每个瓶中放入一枚铁钉。",
        "validation": "bottles_labeled"
      },
      {
        "order": 2,
        "instruction": "A瓶：加入干燥剂并密封（干燥无水环境）；B瓶：加入清水淹没铁钉一半；C瓶：加入盐水淹没铁钉一半；D瓶：加入食用油完全淹没铁钉（隔绝空气）。",
        "validation": "conditions_set"
      },
      {
        "order": 3,
        "instruction": "将4个瓶子放在相同的室温环境下。每天在固定时间观察铁钉表面的变化，在记录本上画图或拍照记录。",
        "validation": "daily_observation"
      },
      {
        "order": 4,
        "instruction": "一周后对比4枚铁钉的状态。预期结果：A（几乎不生锈）、B（少量锈斑）、C（明显生锈）、D（几乎不生锈）。",
        "validation": "week_comparison"
      },
      {
        "order": 5,
        "instruction": "分析实验结果：生锈需要水和氧气同时存在，盐分会加速生锈。思考日常生活中有哪些防锈方法。",
        "validation": "analysis_complete"
      }
    ],
    "success_condition": "analysis_complete",
    "fun_facts": [
      "每年因铁制品生锈造成的经济损失约占全球钢铁产量的10%，相当于数千亿美元。",
      "不锈钢之所以'不锈'，是因为添加了铬元素，铬在表面形成致密的氧化膜，阻止了内部的铁继续被氧化。"
    ],
    "follow_up_questions": [
      {
        "stem": "以下哪种情况下铁钉最容易生锈？",
        "options": ["密封在装有干燥剂的瓶中", "浸泡在盐水中并暴露在空气中", "完全浸没在食用油中"],
        "answer": 1
      }
    ],
    "points": 25,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  }
