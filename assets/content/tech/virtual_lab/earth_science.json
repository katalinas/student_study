    "difficulty": 2,
    "tags": ["tech", "earth_science", "岩石", "分类", "地质"],
    "title": "岩石分类观察",
    "category": "地球科学实验",
    "cover_image": null,
    "description": "收集不同种类的岩石样本，通过观察颜色、纹理、硬度、光泽等特征，学习岩石的三大类别——岩浆岩、沉积岩和变质岩的区分方法。",
    "learning_goals": [
      "认识岩石的三大类别：岩浆岩、沉积岩和变质岩",
      "学会通过观察外观特征对岩石进行初步分类",
      "了解不同类型岩石的形成过程"
    ],
    "components": [
      {"id": "rocks", "name": "各种岩石样本（至少6种）", "icon": "rock.png", "count": 6},
      {"id": "magnifier", "name": "放大镜", "icon": "magnifier.png", "count": 1},
      {"id": "nail", "name": "铁钉（测硬度）", "icon": "nail.png", "count": 1},
      {"id": "vinegar", "name": "白醋（测碳酸盐）", "icon": "vinegar.png", "count": 1},
      {"id": "notebook", "name": "观察记录本", "icon": "notebook.png", "count": 1},
      {"id": "dropper", "name": "滴管", "icon": "dropper.png", "count": 1}
    ],
    "steps": [
      {
        "order": 1,
        "instruction": "从户外收集至少6块不同的岩石，或使用岩石标本。编号后逐一观察每块岩石的颜色、光泽（是否发亮）和表面纹理。",
        "validation": "visual_observation_done"
      },
      {
        "order": 2,
        "instruction": "用放大镜仔细观察岩石内部结构：是否能看到明显的颗粒？颗粒大小是否均匀？是否有层状纹理？是否有气孔？",
        "validation": "structure_examined"
      },
      {
        "order": 3,
        "instruction": "硬度测试：用铁钉在岩石表面轻轻刻划。能被轻易划出痕迹的较软（如石灰岩），不容易划出痕迹的较硬（如花岗岩）。",
        "validation": "hardness_tested"
      },
      {
        "order": 4,
        "instruction": "在每块岩石上滴几滴白醋。如果冒小泡泡（有嘶嘶声），说明含有碳酸盐成分，很可能是石灰岩（沉积岩）。",
        "validation": "acid_test_done"
      },
      {
        "order": 5,
        "instruction": "根据观察结果进行分类：有气孔或结晶颗粒的可能是岩浆岩（如玄武岩、花岗岩）；有层状纹理或化石的是沉积岩（如石灰岩、砂岩）；有弯曲条纹或片状结构的是变质岩（如大理石、板岩）。",
        "validation": "classification_complete"
      }
    ],
    "success_condition": "classification_complete",
    "fun_facts": [
      "地球上最古老的岩石约有40亿年的历史，来自加拿大北部的阿卡斯塔片麻岩，几乎和地球本身一样古老。",
      "大理石其实是石灰岩经过高温高压变质形成的——很多著名的雕塑和建筑都是用大理石制作的，比如米开朗基罗的《大卫》。"
    ],
    "follow_up_questions": [
      {
        "stem": "在岩石上滴白醋后冒出气泡，这块岩石最可能是哪种类型？",
        "options": ["花岗岩（岩浆岩）", "石灰岩（沉积岩）", "板岩（变质岩）"],
        "answer": 1
      }
    ],
    "points": 20,
