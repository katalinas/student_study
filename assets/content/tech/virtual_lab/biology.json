  {
    "id": "tech_e_405",
    "module": "tech",
    "type": "experiment",
    "grade_min": 5,
    "grade_max": 8,
    "difficulty": 3,
    "tags": ["tech", "biology", "DNA", "提取", "草莓"],
    "title": "DNA提取（草莓）",
    "category": "生物实验",
    "cover_image": null,
    "description": "用家庭常见材料从草莓中提取DNA。通过捣碎、溶解细胞膜、过滤和酒精沉淀等步骤，最终用肉眼看到白色絮状的DNA丝。",
    "learning_goals": [
      "了解DNA是生物体内携带遗传信息的物质",
      "学习从细胞中提取DNA的基本原理和步骤",
      "理解洗涤剂破坏细胞膜、酒精使DNA沉淀的科学原理"
    ],
    "components": [
      {"id": "strawberry", "name": "新鲜草莓", "icon": "strawberry.png", "count": 3},
      {"id": "ziplock_bag", "name": "密封袋", "icon": "bag.png", "count": 1},
      {"id": "dish_soap", "name": "洗洁精", "icon": "soap.png", "count": 1},
      {"id": "salt", "name": "食盐", "icon": "salt.png", "count": 1},
      {"id": "alcohol", "name": "冰冻高浓度酒精（>90%）", "icon": "alcohol.png", "count": 1},
      {"id": "cup", "name": "透明玻璃杯", "icon": "cup.png", "count": 2},
      {"id": "coffee_filter", "name": "咖啡滤纸或纱布", "icon": "filter.png", "count": 1},
      {"id": "chopstick", "name": "竹筷", "icon": "chopstick.png", "count": 1}
    ],
    "steps": [
      {
        "order": 1,
        "instruction": "将3颗草莓放入密封袋中，用手反复捣碎约2分钟，直到变成均匀的糊状（这一步是为了破碎细胞）。",
        "validation": "cells_broken"
      },
      {
        "order": 2,
        "instruction": "配制提取液：在半杯温水中加入1勺食盐和2勺洗洁精，轻轻搅拌（不要产生泡沫）。将提取液倒入密封袋中与草莓糊混合，轻柔翻转3分钟。",
        "validation": "extraction_mixed"
      },
      {
        "order": 3,
        "instruction": "将咖啡滤纸放在另一个杯子上，将密封袋中的混合液缓慢倒入过滤，收集下方清亮的滤液（约2-3厘米深即可）。",
        "validation": "filtration_done"
      },
      {
        "order": 4,
        "instruction": "将冰冻的高浓度酒精沿杯壁缓缓倒入滤液中（约等量），不要搅拌，让酒精形成上层。等待2-3分钟。",
        "validation": "alcohol_layer_added"
      },
      {
        "order": 5,
        "instruction": "观察两层液体交界处出现白色絮状物——这就是草莓的DNA！用竹筷轻轻缠绕可以将DNA丝挑出来观察。",
        "validation": "dna_visible"
      }
    ],
    "success_condition": "dna_visible",
    "fun_facts": [
      "草莓是提取DNA的理想材料，因为草莓是八倍体植物——每个细胞里有8套染色体，含有比大多数生物更多的DNA。",
      "如果把一个人体细胞里的所有DNA拉成一条直线，长度约2米。而全身约37万亿个细胞的DNA连起来，可以在太阳和地球之间往返约600次！"
    ],
    "follow_up_questions": [
      {
        "stem": "在DNA提取实验中，加入洗洁精的主要作用是什么？",
        "options": ["给DNA染色", "溶解破坏细胞膜释放DNA", "让DNA溶解在水中"],
        "answer": 1
      }
    ],
    "points": 25,
    "version": 1,
    "created_at": "2026-03-27",
    "updated_at": "2026-03-27"
  }
