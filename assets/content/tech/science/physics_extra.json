    "stem": "机械效率的计算公式是？",
    "options": [
      {"label": "A", "text": "η = 总功 / 有用功 × 100%"},
      {"label": "B", "text": "η = 有用功 / 总功 × 100%"},
      {"label": "C", "text": "η = 额外功 / 总功 × 100%"},
