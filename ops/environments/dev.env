# Development Environment Configuration
# Source this file or set APP_ENV=dev to load automatically.

APP_ENV=dev
APP_NAME=StudentStudy
APP_DEBUG=true

# API Configuration
API_BASE_URL=http://localhost:8080/api
API_TIMEOUT_SECONDS=30

# Feature Flags
FEATURE_ANALYTICS=false
FEATURE_CRASH_REPORTING=false
FEATURE_VERBOSE_LOGGING=true

# Storage
LOCAL_STORAGE_PREFIX=student_study_dev
CACHE_TTL_MINUTES=5

# Build Configuration
FLUTTER_BUILD_MODE=debug
DART_DEFINES=APP_ENV=dev,APP_DEBUG=true
