# Staging Environment Configuration
# Mirrors production settings with relaxed constraints for testing.

APP_ENV=staging
APP_NAME=StudentStudy
APP_DEBUG=false

# API Configuration
API_BASE_URL=https://staging-api.studentStudy.example.com/api
API_TIMEOUT_SECONDS=15

# Feature Flags
FEATURE_ANALYTICS=true
FEATURE_CRASH_REPORTING=true
FEATURE_VERBOSE_LOGGING=false

# Storage
LOCAL_STORAGE_PREFIX=student_study_staging
CACHE_TTL_MINUTES=15

# Build Configuration
FLUTTER_BUILD_MODE=release
DART_DEFINES=APP_ENV=staging,APP_DEBUG=false
