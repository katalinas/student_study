# Production Environment Configuration
# This file contains NON-SENSITIVE configuration only.
# Secrets (API keys, tokens) must be injected via CI/CD variables
# or a secrets manager. Never commit secrets to version control.

APP_ENV=prod
APP_NAME=StudentStudy
APP_DEBUG=false

# API Configuration
API_BASE_URL=https://api.studentStudy.example.com/api
API_TIMEOUT_SECONDS=10

# Feature Flags
FEATURE_ANALYTICS=true
FEATURE_CRASH_REPORTING=true
FEATURE_VERBOSE_LOGGING=false

# Storage
LOCAL_STORAGE_PREFIX=student_study
CACHE_TTL_MINUTES=60

# Build Configuration
FLUTTER_BUILD_MODE=release
DART_DEFINES=APP_ENV=prod,APP_DEBUG=false
